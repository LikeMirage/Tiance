TIANCE_SHELL_USE_EMBEDDED_PYTHON=true
TIANCE_SHELL_MANAGE_BACKEND=true
TIANCE_API_HOST=127.0.0.1
# Leave TIANCE_API_PORT empty to let the shell choose the first available port in TIANCE_API_PORT_RANGE.
TIANCE_API_PORT=
TIANCE_API_PORT_RANGE=18000-18020
TIANCE_FRONTEND_DEV_URL=http://127.0.0.1:18100
TIANCE_APP_URL=
TIANCE_FRONTEND_DIST_DIR=../2_ReactWeb/dist
TIANCE_SHELL_DEBUG=true
TIANCE_SHELL_TITLE=Tiance
TIANCE_ALLOW_REMOTE_SHELL_API=false
TIANCE_FRAMELESS=true
TIANCE_EASY_DRAG=false
TIANCE_WINDOW_SHADOW=false
TIANCE_WINDOW_WIDTH=1440
TIANCE_WINDOW_HEIGHT=900
TIANCE_WINDOW_MIN_WIDTH=1080
TIANCE_WINDOW_MIN_HEIGHT=720
TIANCE_WINDOW_BG=#1e1e1e
TIANCE_WEBVIEW2_RUNTIME_PATH=
TIANCE_WEBVIEW_STORAGE_PATH=
