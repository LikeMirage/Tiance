# Workspace-local application state
/.Tiance/
**/.Tiance/
/Data/*
!/Data/tools/
!/Data/tools/**
!/Data/themes/
!/Data/themes/**
!/Data/providers/
!/Data/providers/**
# New provider directories stay local. Existing tracked public presets remain tracked.
# Publishing a new preset requires scripts/package-providers.json and explicit git add -f.
/Data/providers/*/
!/Data/locales/
!/Data/locales/**

# Runtime-generated data inside published collections
Data/**/.market-cache/
Data/**/.downloads/
Data/**/.trash/
Data/**/market-settings.json

# Tool config templates are published with empty credentials; backups remain local.
Data/tools/**/program/config.json.*
Data/tools/catalog.json.backup*
Data/tools/catalog.json.bak*
Data/locales/locale-settings.json
Data/providers/catalog.json
Data/providers/*/credentials.json
Data/providers/*/cloud-model-cache.json
!/runtime/**
runtime/tool-processes/
runtime/python-packages/**/__pycache__/
runtime/python-packages/**/*.pyc
runtime/python-packages/backend/py313/site-packages/bin/dul-receive-pack
runtime/python-packages/backend/py313/site-packages/bin/dul-upload-pack
runtime/python-packages/backend/py313/site-packages/bin/dulwich.exe
Data/tools/**/__pycache__/
Data/tools/81672808-f39b-5c7b-9e00-99bceed762b0/dependencies/
Data/tools/c7dd4066-37a6-4b1e-a67a-d39f0c6d4a21/dependencies/
Data/tools/**/dependencies/py313/site-packages/playwright/driver/node.exe

# Local workspace state may be created inside otherwise published collections.
**/.Tiance/
/.codex_tmp/

