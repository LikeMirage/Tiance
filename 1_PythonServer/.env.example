# Backend process controls
TIANCE_API_USE_EMBEDDED_PYTHON=true
TIANCE_API_RELOAD=true
TIANCE_API_HOST=127.0.0.1
TIANCE_API_PORT=18000
TIANCE_API_GRACEFUL_SHUTDOWN_TIMEOUT=5

# FastAPI settings
APP_NAME="Tiance API Server"
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/api

# Local data paths
DATABASE_FILE=Data/db/tiance.db
PROJECTS_DATA_DIR=Data/projects
TOOLS_DATA_DIR=Data/tools
KNOWLEDGE_DATA_DIR=Data/knowledge
EXPERIENCE_DATA_DIR=Data/experience
ROLES_DATA_DIR=Data/roles
MEMORY_DATA_DIR=Data/memory
USAGE_DATA_DIR=Data/usage
THEMES_DATA_DIR=Data/themes
LOCALES_DATA_DIR=Data/locales
RUNTIME_ENV_DIR=runtime
FRONTEND_DIST_DIR=2_ReactWeb/dist

# GitHub App (public identifier, not a secret)
GITHUB_CLIENT_ID=Iv23liNTtDOlpz60vMVw

# Tool dependencies
TOOL_DEPENDENCY_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
TOOL_DEPENDENCY_INSTALL_TIMEOUT_SECONDS=300

# CORS
ALLOWED_ORIGINS=http://127.0.0.1:18100,http://localhost:18100,https://pywebview.flowrl.com
ALLOWED_ORIGIN_REGEX=
ALLOW_NULL_ORIGIN=false
ALLOW_FILE_ORIGIN=false
