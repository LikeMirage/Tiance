{
  "additionalProperties": false,
  "description": "query 为必填搜索词。默认使用 Tavily basic 搜索、返回 5 条结果和 basic answer，不返回原文。需要查看网页正文片段时把 include_raw_content 设为 markdown 或 text；需要限制来源时使用 include_domains 或 exclude_domains。",
  "properties": {
    "query": {
      "permission_type": "network_access",
      "description": "搜索查询词，建议写成清晰的关键词或问题。",
      "minLength": 1,
      "title": "搜索词",
      "type": "string"
    },
    "max_results": {
      "permission_type": "none",
      "default": 5,
      "description": "最多返回多少条搜索结果。",
      "maximum": 20,
      "minimum": 1,
      "title": "结果数量",
      "type": "integer"
    },
    "search_depth": {
      "permission_type": "none",
      "default": "basic",
      "description": "搜索深度。basic 平衡速度和质量；advanced 更精确但消耗更多；fast 和 ultra-fast 更快。",
      "enum": [
        "basic",
        "advanced",
        "fast",
        "ultra-fast"
      ],
      "options": [
        {
          "description": "平衡速度和质量，默认推荐。",
          "value": "basic"
        },
        {
          "description": "更高相关性和更多片段，耗时更长且通常消耗更多额度。",
          "value": "advanced"
        },
        {
          "description": "优先速度，同时保持可用相关性。",
          "value": "fast"
        },
        {
          "description": "最低延迟，适合只需快速初筛。",
          "value": "ultra-fast"
        }
      ],
      "title": "搜索深度",
      "type": "string"
    },
    "topic": {
      "permission_type": "none",
      "default": "general",
      "description": "搜索类别。新闻类问题用 news，财经市场类问题用 finance，其余用 general。",
      "enum": [
        "general",
        "news",
        "finance"
      ],
      "options": [
        {
          "description": "通用网页搜索。",
          "value": "general"
        },
        {
          "description": "新闻搜索，适合近期事件。",
          "value": "news"
        },
        {
          "description": "财经搜索，适合公司、市场和金融信息。",
          "value": "finance"
        }
      ],
      "title": "搜索类别",
      "type": "string"
    },
    "time_range": {
      "permission_type": "none",
      "description": "按发布时间或更新时间限制范围。可不填；需要近期内容时用 day/week/month/year 或 d/w/m/y。",
      "enum": [
        "day",
        "week",
        "month",
        "year",
        "d",
        "w",
        "m",
        "y"
      ],
      "options": [
        {
          "description": "最近一天。",
          "value": "day"
        },
        {
          "description": "最近一周。",
          "value": "week"
        },
        {
          "description": "最近一月。",
          "value": "month"
        },
        {
          "description": "最近一年。",
          "value": "year"
        },
        {
          "description": "最近一天的短写。",
          "value": "d"
        },
        {
          "description": "最近一周的短写。",
          "value": "w"
        },
        {
          "description": "最近一月的短写。",
          "value": "m"
        },
        {
          "description": "最近一年的短写。",
          "value": "y"
        }
      ],
      "title": "时间范围",
      "type": "string"
    },
    "start_date": {
      "permission_type": "none",
      "description": "只返回此日期之后发布或更新的结果，格式 YYYY-MM-DD。",
      "title": "开始日期",
      "type": "string"
    },
    "end_date": {
      "permission_type": "none",
      "description": "只返回此日期之前发布或更新的结果，格式 YYYY-MM-DD。",
      "title": "结束日期",
      "type": "string"
    },
    "include_raw_content": {
      "permission_type": "none",
      "default": "none",
      "description": "是否返回每条结果的原文内容。默认 none 只返回摘要；markdown 返回 Markdown 原文片段；text 返回纯文本原文片段。",
      "enum": [
        "none",
        "markdown",
        "text"
      ],
      "options": [
        {
          "description": "不返回原文，减少上下文占用。",
          "value": "none"
        },
        {
          "description": "返回 Markdown 格式原文片段。",
          "value": "markdown"
        },
        {
          "description": "返回纯文本原文片段，可能更慢。",
          "value": "text"
        }
      ],
      "title": "原文内容",
      "type": "string"
    },
    "include_domains": {
      "permission_type": "network_access",
      "description": "只搜索这些域名。填写域名即可，如 example.com；最多 300 个。",
      "items": {
        "type": "string"
      },
      "maxItems": 300,
      "title": "包含域名",
      "type": "array",
      "uniqueItems": true
    },
    "exclude_domains": {
      "permission_type": "network_access",
      "description": "排除这些域名。填写域名即可，如 example.com；最多 150 个。",
      "items": {
        "type": "string"
      },
      "maxItems": 150,
      "title": "排除域名",
      "type": "array",
      "uniqueItems": true
    },
    "request_timeout_seconds": {
      "permission_type": "none",
      "default": 60,
      "description": "请求 Tavily API 的超时时间。",
      "maximum": 300,
      "minimum": 10,
      "title": "请求超时秒数",
      "type": "integer"
    }
  },
  "required": [
    "query"
  ],
  "type": "object"
}
