{
  "description": "调用 Tavily Search API 执行实时网络搜索，返回 AI 总结、结果标题、链接、摘要、相关度、发布时间和可选原文内容。",
  "registration_name": "Tavily 网络搜索",
  "execution": {
    "parallel": true
  },
  "files": {
    "examples": ".tool/examples.json",
    "permissions": ".tool/permissions.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "keywords": [
    "Tavily",
    "网络搜索",
    "实时搜索",
    "新闻搜索",
    "网页检索",
    "资料查询"
  ],
  "loading": {
    "dynamic": true
  },
  "name": "tavily_web_search",
  "runtime": {
    "entry": "program/main.py",
    "timeout_seconds": 120,
    "type": "python"
  },
  "state": {
    "enabled": true
  }
}
