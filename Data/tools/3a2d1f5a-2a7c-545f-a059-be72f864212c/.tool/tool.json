{
  "description": "读取、创建和编辑 Excel 工作簿，或提取为 Markdown。导出前读取“Excel 提取规则”。",
  "registration_name": "Excel 工作簿",
  "execution": {
    "parallel": true
  },
  "files": {
    "examples": ".tool/examples.json",
    "permissions": ".tool/permissions.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "loading": {
    "dynamic": true
  },
  "name": "excel_workbook",
  "runtime": {
    "entry": "program/main.py",
    "timeout_seconds": 300,
    "type": "python"
  },
  "state": {
    "enabled": true
  }
}
