{
  "additionalProperties": true,
  "description": "成功时返回 SerpAPI 搜索结果、搜索元信息、归一化结果列表、相关搜索和可选原始响应片段；失败时返回 ok=false、error 和 error_info。",
  "properties": {
    "ok": {
      "description": "是否成功。",
      "type": "boolean"
    },
    "summary": {
      "description": "简短结果摘要。",
      "type": "string"
    },
    "data": {
      "description": "成功时的结构化搜索结果。",
      "type": "object"
    },
    "warnings": {
      "description": "非阻断警告，例如内容被截断或某些额外参数被拒绝。",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "error": {
      "description": "失败时的错误说明。",
      "type": "string"
    },
    "error_info": {
      "description": "失败时的机器可读错误信息。",
      "type": "object"
    }
  },
  "required": [
    "ok"
  ],
  "type": "object"
}
