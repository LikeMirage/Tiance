{
  "description": "提交后台记忆压缩的累计摘要；也可在用户明确要求时登记手动压缩请求。",
  "registration_name": "提交记忆压缩",
  "execution": {
    "parallel": true
  },
  "files": {
    "examples": ".tool/examples.json",
    "permissions": ".tool/permissions.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "loading": {
    "dynamic": false
  },
  "name": "submit_memory_compaction",
  "runtime": {
    "entry": "program/main.py",
    "timeout_seconds": 30,
    "type": "python"
  },
  "state": {
    "enabled": true
  }
}
