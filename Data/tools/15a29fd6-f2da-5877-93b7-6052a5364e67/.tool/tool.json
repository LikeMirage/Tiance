{
  "description": "执行测试、构建和环境检查等短命令并收集输出。完整 Python 脚本或后台任务使用 run_python_script。",
  "registration_name": "命令行执行",
  "execution": {
    "parallel": true
  },
  "files": {
    "examples": ".tool/examples.json",
    "permissions": ".tool/permissions.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "loading": {
    "dynamic": false
  },
  "name": "run_command",
  "runtime": {
    "entry": "program/main.py",
    "timeout_seconds": 180,
    "type": "python"
  },
  "state": {
    "enabled": true
  }
}
