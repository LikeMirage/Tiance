{
  "name": "github_issue",
  "registration_name": "GitHub 议题",
  "description": "管理 GitHub 议题、评论、标签和负责人。",
  "execution": {
    "parallel": true
  },
  "loading": {
    "dynamic": true
  },
  "state": {
    "enabled": true
  },
  "runtime": {
    "type": "python",
    "entry": "program/main.py",
    "timeout_seconds": 600,
    "host_capabilities": [
      "github_issues"
    ]
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "files": {
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json",
    "examples": ".tool/examples.json",
    "permissions": ".tool/permissions.json"
  }
}
