{
  "description": "通过 DeepSeek 官方 Search/Fetch 接口搜索和读取网页，直接返回搜索结果或网页内容，不调用对话模型。",
  "execution": {
    "parallel": true
  },
  "files": {
    "examples": ".tool/examples.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json",
    "permissions": ".tool/permissions.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "loading": {
    "dynamic": false
  },
  "name": "deepseek_official_web_search",
  "registration_name": "DeepSeek 官方网络搜索",
  "runtime": {
    "entry": "program/main.py",
    "host_capabilities": [
      "deepseek_web"
    ],
    "timeout_seconds": 180,
    "type": "python"
  },
  "state": {
    "enabled": true
  }
}
