{
  "description": "使用 DeepSeek 官方独立 Search/Fetch 接口搜索和读取网页，不调用对话模型。config.json 的 Key 优先，未填写时通过能力桥使用模型集 DeepSeek 的 Key；可用 configure 配置或清除工具 Key。搜索支持 1～50 条、可选正文及网站/语言/日期语法。短文本直接返回，长文本完整落盘并返回路径、大小和字符数。",
  "execution": {
    "parallel": true
  },
  "files": {
    "examples": ".tool/examples.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json",
    "permissions": ".tool/permissions.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "loading": {
    "dynamic": false
  },
  "name": "deepseek_official_web_search",
  "registration_name": "DeepSeek 官方网络搜索",
  "runtime": {
    "entry": "program/main.py",
    "host_capabilities": [
      "deepseek_web"
    ],
    "timeout_seconds": 180,
    "type": "python"
  },
  "state": {
    "enabled": true
  }
}
