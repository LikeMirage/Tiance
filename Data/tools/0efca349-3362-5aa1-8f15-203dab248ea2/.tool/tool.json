{
  "description": "向 Telegram、飞书或微信发送纯文本或文件。远程用户看不到天策中的思考、工具调用和中途文字：收到远程请求后，无论后续有多少轮工具调用，都必须先用 send_text 回复来源用户、说明接下来做什么，再开始处理任务；关键步骤前后必须主动汇报行动与结果，遇到阻碍及时告知，不能等最终回复才联系。仅发送，不等待答复。",
  "execution": {
    "parallel": true
  },
  "files": {
    "examples": ".tool/examples.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json",
    "permissions": ".tool/permissions.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "loading": {
    "dynamic": true
  },
  "name": "external_send_file",
  "registration_name": "对外消息发送",
  "runtime": {
    "entry": "program/main.py",
    "host_capabilities": [
      "external_messaging"
    ],
    "timeout_seconds": 600,
    "type": "python"
  },
  "state": {
    "enabled": true
  }
}
