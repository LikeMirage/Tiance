{
  "name": "github_repository",
  "registration_name": "GitHub 仓库",
  "description": "管理 GitHub 远端仓库，包括创建、配置、Fork 和删除；本地版本管理使用 git_repository。",
  "execution": {
    "parallel": true
  },
  "loading": {
    "dynamic": true
  },
  "state": {
    "enabled": true
  },
  "runtime": {
    "type": "python",
    "entry": "program/main.py",
    "timeout_seconds": 600,
    "host_capabilities": [
      "github_repositories"
    ]
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "files": {
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json",
    "examples": ".tool/examples.json",
    "permissions": ".tool/permissions.json"
  }
}
