{
  "description": "查看、创建、审查和合并 GitHub Pull Request。",
  "execution": {
    "parallel": true
  },
  "files": {
    "examples": ".tool/examples.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json",
    "permissions": ".tool/permissions.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "loading": {
    "dynamic": true
  },
  "name": "github_pull_request",
  "registration_name": "GitHub PR",
  "runtime": {
    "entry": "program/main.py",
    "timeout_seconds": 600,
    "type": "python",
    "host_capabilities": [
      "github_pull_requests"
    ]
  },
  "state": {
    "enabled": true
  }
}
