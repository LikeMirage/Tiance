{
  "name": "conversation_history_search",
  "registration_name": "会话原始历史检索",
  "description": "只读检索当前项目各会话的原始消息、模型交换、运行事件和原始 HTTP 记录。",
  "execution": {
    "parallel": true
  },
  "loading": {
    "dynamic": true
  },
  "state": {
    "enabled": true
  },
  "runtime": {
    "type": "python",
    "entry": "program/main.py",
    "timeout_seconds": 120
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "files": {
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json",
    "examples": ".tool/examples.json",
    "permissions": ".tool/permissions.json"
  }
}
