{
  "type": "object",
  "additionalProperties": true,
  "required": [
    "ok"
  ],
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "summary": {
      "type": "string"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "type",
              "size_bytes"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "file",
                  "directory"
                ]
              },
              "size_bytes": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            }
          }
        },
        "count": {
          "type": "integer"
        },
        "has_more": {
          "type": "boolean"
        },
        "next_offset": {
          "type": [
            "integer",
            "null"
          ]
        },
        "offset": {
          "type": "integer"
        },
        "page_size": {
          "type": "integer"
        },
        "pagination_consistency": {
          "const": "live_index"
        },
        "active": {
          "type": "boolean"
        },
        "index_ready": {
          "type": "boolean",
          "description": "Everything数据库是否已就绪；不表示全盘均已索引。"
        },
        "everything_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "instance": {
          "type": "string"
        },
        "state_directory": {
          "type": "string"
        },
        "search_scope": {
          "const": "everything_index"
        },
        "content_search": {
          "const": "on_demand"
        }
      }
    },
    "error": {
      "type": "string"
    },
    "error_info": {
      "type": "object"
    }
  }
}
