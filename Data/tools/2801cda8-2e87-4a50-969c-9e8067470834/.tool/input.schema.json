{
  "type": "object",
  "description": "先等待 gui_runtime start 成功；除列窗口外，操作使用 gui_inspect 建立的真实会话与最新观察结果。用户中断或解锁后须重新建立会话。完整流程及异常处理见本工具“操作流程与注意事项”。",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "inspect",
        "read",
        "invoke",
        "set_value",
        "select",
        "toggle",
        "expand",
        "collapse",
        "focus"
      ],
      "permission_type": "ui_control",
      "description": "inspect 获取控件；read 读取状态；其余动作执行控件实际支持的对应能力。"
    },
    "gui_session_id": {
      "type": "string",
      "pattern": "^gui_[a-f0-9]{32}$",
      "permission_type": "none",
      "description": "gui_inspect start 实际返回的 GUI 会话 ID，不使用示例占位值。"
    },
    "element_id": {
      "type": "string",
      "pattern": "^uia_[a-f0-9]{32}:[0-9]+$",
      "description": "使用本GUI会话inspect实际返回的编号，不是automation_id。",
      "permission_type": "none"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^uia_[a-f0-9]{32}$",
      "description": "inspect翻页时提供原快照编号；省略时重新读取完整控件树。",
      "permission_type": "none"
    },
    "query": {
      "type": "string",
      "default": "",
      "description": "inspect按名称或automation_id包含文字筛选，不区分大小写；翻页使用相同query。先读取完整控件树再筛选，query不缩减读取范围。",
      "permission_type": "none"
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "inspect分页起点；大于0必须提供snapshot_id。",
      "permission_type": "none"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500,
      "default": 100,
      "description": "inspect单页数量，只控制传输页大小，不缩减完整控件树的读取范围；全部控件留在快照，total/complete/next_offset说明是否读完。",
      "permission_type": "none"
    },
    "timeout_seconds": {
      "type": "number",
      "minimum": 1,
      "maximum": 60,
      "default": 10,
      "description": "本次UIA读取或动作（含工作进程启动）的时限；超时不自动重试。动作超时可能已生效，返回unknown。",
      "permission_type": "none"
    },
    "screenshot_delay_seconds": {
      "type": "number",
      "minimum": 0,
      "maximum": 30,
      "default": 1,
      "description": "仅动作使用，动作结束后等待再截图的秒数；截图沿用GUI会话目标，失败不抹掉已执行结果。",
      "permission_type": "none"
    },
    "text": {
      "type": "string",
      "maxLength": 100000,
      "description": "set_value完整替换输入框内容，最多100000字符，超出明确拒绝。",
      "permission_type": "none"
    }
  },
  "required": [
    "action",
    "gui_session_id"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "action": {
          "enum": [
            "inspect"
          ]
        },
        "gui_session_id": {},
        "timeout_seconds": {},
        "snapshot_id": {},
        "query": {},
        "offset": {},
        "limit": {}
      },
      "required": [
        "action",
        "gui_session_id"
      ],
      "additionalProperties": false
    },
    {
      "properties": {
        "action": {
          "enum": [
            "read"
          ]
        },
        "gui_session_id": {},
        "timeout_seconds": {},
        "element_id": {}
      },
      "required": [
        "action",
        "gui_session_id",
        "element_id"
      ],
      "additionalProperties": false
    },
    {
      "properties": {
        "action": {
          "enum": [
            "set_value"
          ]
        },
        "gui_session_id": {},
        "timeout_seconds": {},
        "element_id": {},
        "text": {},
        "screenshot_delay_seconds": {}
      },
      "required": [
        "action",
        "gui_session_id",
        "element_id",
        "text"
      ],
      "additionalProperties": false
    },
    {
      "properties": {
        "action": {
          "enum": [
            "invoke",
            "select",
            "toggle",
            "expand",
            "collapse",
            "focus"
          ]
        },
        "gui_session_id": {},
        "timeout_seconds": {},
        "element_id": {},
        "screenshot_delay_seconds": {}
      },
      "required": [
        "action",
        "gui_session_id",
        "element_id"
      ],
      "additionalProperties": false
    }
  ]
}
