{
  "description": "读取和操作 Windows 暴露的界面控件，适合按钮、输入框和列表。首次使用前读取“操作流程与注意事项”。",
  "execution": {
    "parallel": false
  },
  "files": {
    "examples": ".tool/examples.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json",
    "permissions": ".tool/permissions.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "loading": {
    "dynamic": true
  },
  "name": "gui_uia",
  "registration_name": "GUI 控件操作",
  "runtime": {
    "entry": "program/main.py",
    "timeout_seconds": 100,
    "type": "python"
  },
  "state": {
    "enabled": true
  }
}
