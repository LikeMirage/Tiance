{
  "description": "查看当前主题，精简列出、创建、克隆、自动派生配色、编辑、切换、恢复和删除 天策 主题配置。主题是 Data/themes 下的独立主题包，主题内容在 theme.json，资源放在包内 assets；克隆会完整复制源主题配置和资源并使用新的 ID 与名称；配色派生从背景、面板、正文和强调四个基础色确定性生成完整颜色 Token；编辑使用字段路径和值，避免破坏主题结构；删除主题时会删除整个未激活主题包。",
  "registration_name": "主题设计工具",
  "execution": {
    "parallel": true
  },
  "files": {
    "examples": ".tool/examples.json",
    "permissions": ".tool/permissions.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "keywords": [
    "主题",
    "主题设计",
    "克隆主题",
    "自动配色",
    "列出主题",
    "查看主题",
    "颜色",
    "界面风格",
    "恢复主题",
    "切换主题",
    "删除主题"
  ],
  "loading": {
    "dynamic": true
  },
  "name": "theme_designer",
  "runtime": {
    "entry": "program/main.py",
    "timeout_seconds": 60,
    "type": "python"
  },
  "state": {
    "enabled": true
  }
}
