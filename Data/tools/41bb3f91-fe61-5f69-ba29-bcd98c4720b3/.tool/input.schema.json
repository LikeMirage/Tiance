{
  "additionalProperties": false,
  "description": "创建、检查或安全编辑 .docx。action=create 时传 output_path 和 elements；action=inspect 时传 input_path；action=edit 时传 input_path、output_path 和 operations。编辑默认输出新文件，不直接改原文件。",
  "properties": {
    "action": {
      "description": "操作类型。",
      "enum": [
        "create",
        "inspect",
        "edit"
      ],
      "options": [
        {
          "value": "create",
          "description": "从结构化 JSON 新建 DOCX。"
        },
        {
          "value": "inspect",
        "description": "读取 DOCX 概况、标题、段落、表格、图片数量、公式数量和页眉页脚文本。"
        },
        {
          "value": "edit",
          "description": "对已有 DOCX 做安全编辑并输出到新文件或覆盖文件。"
        }
      ],
      "title": "操作",
      "type": "string"
    },
    "input_path": {
      "description": "已有 DOCX 路径。inspect/edit 必填。相对路径按工作区根目录解析。",
      "title": "输入 DOCX",
      "type": "string"
    },
    "output_path": {
      "description": "输出 DOCX 路径。create/edit 必填。相对路径按工作区根目录解析。",
      "title": "输出 DOCX",
      "type": "string"
    },
    "overwrite": {
      "default": false,
      "description": "输出文件已存在时是否覆盖。默认 false。",
      "title": "覆盖输出文件",
      "type": "boolean"
    },
    "backup": {
      "default": true,
      "description": "edit 且覆盖原文件时是否先创建 .bak 备份。",
      "title": "覆盖原文件前备份",
      "type": "boolean"
    },
    "dry_run": {
      "default": false,
      "description": "只检查编辑操作，不写文件。create 时忽略。",
      "title": "预演编辑",
      "type": "boolean"
    },
    "properties": {
      "additionalProperties": true,
      "description": "文档属性，例如 title、subject、author、category、keywords、comments。",
      "title": "文档属性",
      "type": "object"
    },
    "page": {
      "additionalProperties": false,
      "description": "页面和边距设置，单位英寸。orientation 支持 portrait、landscape。",
      "properties": {
        "orientation": {
          "default": "portrait",
          "enum": [
            "portrait",
            "landscape"
          ],
          "type": "string"
        },
        "margin_top": {
          "type": "number"
        },
        "margin_bottom": {
          "type": "number"
        },
        "margin_left": {
          "type": "number"
        },
        "margin_right": {
          "type": "number"
        }
      },
      "title": "页面设置",
      "type": "object"
    },
    "theme": {
      "additionalProperties": true,
      "description": "主题设置。支持 font_family、east_asia_font/eastAsia_font/cjk_font、complex_script_font、heading_color、text_color、accent_color、table_header_color。font_family 不传时默认使用微软雅黑；中文字体不单独指定时跟随 font_family。",
      "title": "主题",
      "type": "object"
    },
    "header": {
      "description": "创建文档时设置页眉文本。",
      "title": "页眉",
      "type": "string"
    },
    "footer": {
      "description": "创建文档时设置页脚文本。",
      "title": "页脚",
      "type": "string"
    },
    "elements": {
      "description": "create 或 append_content 使用的元素数组。支持 heading、paragraph、bullets、numbered、table、image、equation、page_break。equation 会把 LaTeX 转为 Word 原生公式。",
      "items": {
        "additionalProperties": true,
        "properties": {
          "type": {
            "enum": [
              "heading",
              "paragraph",
              "bullets",
              "numbered",
              "table",
              "image",
              "equation",
              "page_break"
            ],
            "type": "string"
          },
          "text": {
            "description": "普通文本；equation 未提供 latex 时也可用 text 作为公式内容。",
            "type": "string"
          },
          "latex": {
            "description": "equation 的 LaTeX 公式内容，例如 \\\\frac{a}{b} 或 \\\\sum_{i=1}^{N} x_i。",
            "type": "string"
          },
          "display": {
            "default": true,
            "description": "equation 是否按展示公式居中排版。false 时左对齐。",
            "type": "boolean"
          },
          "level": {
            "description": "heading 级别，1-9。",
            "type": "integer"
          },
          "items": {
            "description": "bullets/numbered 列表项。",
            "items": {},
            "type": "array"
          },
          "rows": {
            "description": "table 二维数组。",
            "items": {
              "items": {},
              "type": "array"
            },
            "type": "array"
          },
          "image_path": {
            "description": "图片路径，相对路径按工作区根目录解析。",
            "type": "string"
          },
          "width": {
            "description": "图片宽度，单位英寸。",
            "type": "number"
          },
          "style": {
            "additionalProperties": true,
            "description": "样式设置，例如 font_size、font_family、east_asia_font、bold、italic、color、align、space_after、table_style、header_fill。",
            "type": "object"
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "title": "文档元素",
      "type": "array"
    },
    "operations": {
      "description": "edit 操作数组。支持 replace_text、append_content、set_header、set_footer。",
      "items": {
        "additionalProperties": true,
        "properties": {
          "type": {
            "enum": [
              "replace_text",
              "append_content",
              "set_header",
              "set_footer"
            ],
            "type": "string"
          },
          "old_text": {
            "type": "string"
          },
          "new_text": {
            "type": "string"
          },
          "match_case": {
            "default": true,
            "type": "boolean"
          },
          "elements": {
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "title": "编辑操作",
      "type": "array"
    },
    "inspect": {
      "additionalProperties": false,
      "description": "inspect 输出控制。",
      "properties": {
        "include_paragraphs": {
          "default": true,
          "type": "boolean"
        },
        "include_tables": {
          "default": true,
          "type": "boolean"
        },
        "max_paragraphs": {
          "default": 80,
          "maximum": 500,
          "minimum": 1,
          "type": "integer"
        },
        "max_text_chars": {
          "default": 20000,
          "maximum": 100000,
          "minimum": 1000,
          "type": "integer"
        }
      },
      "title": "检查选项",
      "type": "object"
    }
  },
  "required": [
    "action"
  ],
  "type": "object"
}
