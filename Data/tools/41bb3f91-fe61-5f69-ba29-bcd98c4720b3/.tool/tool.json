{
  "description": "创建、检查和安全编辑 .docx Word 文档。除专业报告、按内容分配列宽的表格、图片和经过结构校验的 Word 原生公式外，还支持用左右纯文字边界建立选区，对已有内容执行插入、替换、删除、增量格式修改和提取。写入可用带格式纯文字或 Markdown 片段，常用标题、列表、引用、表格、本地图片、代码和公式会转成 Word 原生结构。编辑默认输出新文件，支持 dry-run、备份和覆盖保护。不负责 Word 转 PDF、目录自动刷新、脚注/HTML 片段转换或跨不同表格单元格的复杂选区。",
  "display_name": "Word 制作编辑",
  "execution": {
    "parallel": false
  },
  "files": {
    "examples": ".tool/examples.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "keywords": [
    "Word",
    "DOCX",
    "文档",
    "报告",
    "制作",
    "编辑",
    "表格",
    "图片",
    "页眉页脚",
    "公式",
    "LaTeX",
    "OMML",
    "选区",
    "Markdown"
  ],
  "loading": {
    "dynamic": true
  },
  "name": "word_document_editor",
  "runtime": {
    "entry": "program/main.py",
    "timeout_seconds": 300,
    "type": "python"
  },
  "state": {
    "enabled": true
  }
}
