{
  "description": "创建、检查和安全编辑 .docx Word 文档。支持专业报告结构、标题层级、段落、要点、编号列表、按内容分配列宽的表格、图片、经过结构校验的 Word 原生数学公式、分页、页眉页脚、页面边距和核心文档属性。编辑默认输出到新文件，支持 dry-run、备份和覆盖保护。不负责 Word 转 PDF、目录自动刷新或精准分页渲染。",
  "display_name": "Word 制作编辑",
  "execution": {
    "parallel": false
  },
  "files": {
    "examples": ".tool/examples.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "keywords": [
    "Word",
    "DOCX",
    "文档",
    "报告",
    "制作",
    "编辑",
    "表格",
    "图片",
    "页眉页脚",
    "公式",
    "LaTeX",
    "OMML"
  ],
  "loading": {
    "dynamic": true
  },
  "name": "word_document_editor",
  "runtime": {
    "entry": "program/main.py",
    "timeout_seconds": 300,
    "type": "python"
  },
  "state": {
    "enabled": true
  }
}
