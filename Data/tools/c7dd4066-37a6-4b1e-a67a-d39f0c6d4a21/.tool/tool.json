{
  "description": "GUI操作前必须调用start锁定界面，再用gui_inspect建立坐标。覆盖层在操作及截图时持续显示，系统将它排除出截图；需要Windows 10 2004或更新版本且启用桌面合成，不支持时明确报错。用户鼠标移动、点击、滚轮和键盘输入均被拦截，仅按Esc手动退出。被拦截的输入不会干扰AI操作。stop解除锁定并清理GUI临时文件（含预览编号），最后一个GUI会话close也会自动解锁。",
  "registration_name": "GUI 界面锁",
  "execution": {"parallel": false},
  "files": {
    "examples": ".tool/examples.json",
    "permissions": ".tool/permissions.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json"
  },
  "io": {"input": "stdin_json", "output": "stdout_json"},
  "keywords": ["GUI", "后台运行器", "AI操控", "屏幕", "Windows"],
  "loading": {"dynamic": true},
  "name": "gui_runtime",
  "runtime": {"entry": "program/main.py", "timeout_seconds": 20, "type": "python"},
  "state": {"enabled": true}
}
