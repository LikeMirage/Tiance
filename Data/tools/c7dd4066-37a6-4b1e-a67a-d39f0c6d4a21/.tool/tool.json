{
  "description": "查看GUI后台运行器状态或手动停止它。通常不需要调用：gui_inspect会在首次使用时自动启动无覆盖层运行器，并在最后一个GUI临时会话关闭时自动停止。运行器只记录用户与AI输入差异，不锁定界面、不拦截用户输入。",
  "registration_name": "GUI 后台运行器",
  "execution": {"parallel": false},
  "files": {
    "examples": ".tool/examples.json",
    "permissions": ".tool/permissions.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json"
  },
  "io": {"input": "stdin_json", "output": "stdout_json"},
  "keywords": ["GUI", "后台运行器", "AI操控", "屏幕", "Windows"],
  "loading": {"dynamic": true},
  "name": "gui_runtime",
  "runtime": {"entry": "program/main.py", "timeout_seconds": 20, "type": "python"},
  "state": {"enabled": true}
}
