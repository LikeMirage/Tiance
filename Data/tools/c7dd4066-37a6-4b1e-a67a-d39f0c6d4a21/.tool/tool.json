{
  "description": "管理 GUI 操作期间的键鼠锁定与释放。首次操作前读取“操作流程与注意事项”。",
  "execution": {
    "parallel": false
  },
  "files": {
    "examples": ".tool/examples.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json",
    "permissions": ".tool/permissions.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "loading": {
    "dynamic": true
  },
  "name": "gui_runtime",
  "registration_name": "GUI 界面锁",
  "runtime": {
    "entry": "program/main.py",
    "timeout_seconds": 30,
    "type": "python",
    "host_capabilities": [
      "run_status"
    ]
  },
  "state": {
    "enabled": true
  }
}
