{
  "description": "将 Markdown 转为 Word，也可提取并复用 Word 样本排版。涉及公式、目录或复杂表格时读取“排版与复杂内容”。",
  "execution": {
    "parallel": true
  },
  "files": {
    "examples": ".tool/examples.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json",
    "permissions": ".tool/permissions.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "loading": {
    "dynamic": true
  },
  "name": "md2docx",
  "registration_name": "Markdown 转 DOCX",
  "runtime": {
    "entry": "program/main.py",
    "timeout_seconds": 120,
    "type": "python"
  },
  "state": {
    "enabled": true
  }
}
