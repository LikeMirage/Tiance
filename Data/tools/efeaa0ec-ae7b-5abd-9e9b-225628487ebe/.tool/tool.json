{
  "description": "读取会话已启用工具的参数详情和应用示例，辅助动态加载工具按需补充上下文。",
  "display_name": "工具信息加载",
  "execution": {
    "parallel": true
  },
  "files": {
    "examples": ".tool/examples.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "keywords": [
    "工具",
    "信息加载",
    "动态加载",
    "参数",
    "示例"
  ],
  "loading": {
    "dynamic": false
  },
  "name": "load_tool_info",
  "runtime": {
    "entry": "program/main.py",
    "timeout_seconds": 600,
    "type": "python"
  },
  "state": {
    "enabled": true
  }
}
