{
  "description": "按需读取工具的完整参数定义、操作指南或调用示例。",
  "registration_name": "工具信息加载",
  "execution": {
    "parallel": true
  },
  "files": {
    "examples": ".tool/examples.json",
    "permissions": ".tool/permissions.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "loading": {
    "dynamic": false
  },
  "name": "load_tool_info",
  "runtime": {
    "entry": "program/main.py",
    "timeout_seconds": 600,
    "type": "python",
    "host_capabilities": [
      "tool_catalog"
    ]
  },
  "state": {
    "enabled": true
  }
}
