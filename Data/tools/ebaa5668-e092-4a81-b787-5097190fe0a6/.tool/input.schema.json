              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "view_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            },
            "required": [
              "cell_id",
              "x",
              "y"
            ]
          },
          "head": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "cell_id": {
                "type": "integer",
                "minimum": 1
              },
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "view_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            },
            "required": [
              "cell_id",
              "x",
              "y"
            ]
          },
          "position": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "cell_id": {
                "type": "integer",
                "minimum": 1
              },
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "view_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            },
            "required": [
              "cell_id",
              "x",
              "y"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "annotation_id"
        ]
      },
      "permission_type": "none",
      "description": "update 的局部修改列表，未传字段保留原值。"
    },
    "annotation_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^ann_[a-f0-9]{32}$"
      },
      "permission_type": "none",
      "description": "delete 要删除的实际标注 ID 列表。"
    }
  },
  "required": [
    "action"
  ],
