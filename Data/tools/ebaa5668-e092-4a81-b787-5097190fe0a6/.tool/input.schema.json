{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "draw/update/delete 必须指定 gui_session_id，其他动作可指定会话或作用于当前项目全部标注。引用真实返回的 Frame、View 和标注 ID；不要求界面锁。完整流程见本工具“操作流程与注意事项”。",
  "additionalProperties": false,
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "draw",
        "update",
        "delete",
        "list",
        "close",
        "show"
      ],
      "permission_type": "ui_control",
      "description": "draw 追加标注；update 局部修改；delete 删除指定标注；list 查看；close 隐藏；show 重新显示。"
    },
    "gui_session_id": {
      "type": "string",
      "pattern": "^gui_[a-f0-9]{32}$",
      "permission_type": "none",
      "description": "gui_inspect start 实际返回的 GUI 会话 ID，不使用示例占位值。"
    },
    "frame_id": {
      "type": "integer",
      "minimum": 0,
      "permission_type": "none",
      "description": "gui_inspect 保存的 Frame ID，可引用已关闭会话保留的截图。"
    },
    "view_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "default": "root",
      "permission_type": "none",
      "description": "来源 Frame 中真实存在的 View ID。"
    },
    "annotations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "grid"
              },
              "color": {
                "type": "string",
                "pattern": "^(#[0-9a-fA-F]{6}|[A-Za-z]+)$",
                "default": "red"
              },
              "size": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 256
                  },
                  {
                    "type": "string",
                    "enum": [
                      "auto"
                    ]
                  }
                ],
                "default": "auto"
              },
              "cell_ids": {
                "type": "array",
                "minItems": 1,
                "maxItems": 256,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "required": [
              "type",
              "cell_ids"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "arrow"
              },
              "color": {
                "type": "string",
                "pattern": "^(#[0-9a-fA-F]{6}|[A-Za-z]+)$",
                "default": "red"
              },
              "size": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 256
                  },
                  {
                    "type": "string",
                    "enum": [
                      "auto"
                    ]
                  }
                ],
                "default": "auto"
              },
              "tail": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "cell_id": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "view_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  }
                },
                "required": [
                  "cell_id",
                  "x",
                  "y"
                ]
              },
              "head": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "cell_id": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "view_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  }
                },
                "required": [
                  "cell_id",
                  "x",
                  "y"
                ]
              }
            },
            "required": [
              "type",
              "tail",
              "head"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "text"
              },
              "color": {
                "type": "string",
                "pattern": "^(#[0-9a-fA-F]{6}|[A-Za-z]+)$",
                "default": "red"
              },
              "size": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 256
                  },
                  {
                    "type": "string",
                    "enum": [
                      "auto"
                    ]
                  }
                ],
                "default": "auto"
              },
              "position": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "cell_id": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "view_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  }
                },
                "required": [
                  "cell_id",
                  "x",
                  "y"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
              "type",
              "position",
              "text"
            ]
          }
        ]
      },
      "permission_type": "none",
      "description": "draw 追加的网格框、箭头或文字标注列表。"
    },
    "updates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 2,
        "properties": {
          "annotation_id": {
            "type": "string",
            "pattern": "^ann_[a-f0-9]{32}$"
