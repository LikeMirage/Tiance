{
  "description": "在屏幕上添加和编辑框选、箭头与文字标注，可独立于界面锁显示。首次使用前读取“操作流程与注意事项”。",
  "execution": {
    "parallel": false
  },
  "files": {
    "examples": ".tool/examples.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json",
    "permissions": ".tool/permissions.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "loading": {
    "dynamic": true
  },
  "name": "gui_annotate",
  "registration_name": "GUI 标注与编辑",
  "runtime": {
    "entry": "program/main.py",
    "timeout_seconds": 60,
    "type": "python"
  },
  "state": {
    "enabled": true
  }
}
