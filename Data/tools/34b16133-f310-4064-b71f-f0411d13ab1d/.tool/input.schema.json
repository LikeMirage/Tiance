  "description": "需要前端在线。先 list/list_categories 核对对象。initialize_current 绑定调用会话的工具集工作区，不接受任意路径/项目 ID。创建后先读 documentation_path；中途失败先检查返回项目，避免重复创建。",
  "properties": {
    "action": {
      "description": "选择管理动作。初始化只补缺失文件，不覆盖已有配置；不会切换当前项目。",
      "enum": [
        "list_categories",
        "create_category",
        "list",
        "get",
        "create_tool",
        "initialize_current",
        "rename",
        "move",
        "delete",
        "set_state"
      ],
      "options": [
        {
          "description": "查看当前集的分类 ID 和名称。",
          "value": "list_categories"
        },
        {
          "description": "按 name 创建分类。",
          "value": "create_category"
        },
        {
          "description": "列出当前集的项目，可按 category_id 筛选。",
          "value": "list"
        },
        {
          "description": "按 project_id 读取对象的当前配置。",
          "value": "get"
        },
        {
          "description": "指定分类和名称，新建工具文件夹及标准内容；默认关闭。",
          "value": "create_tool"
        },
        {
          "description": "只在调用工作区所属集根目录补缺文件，已有内容保留。",
          "value": "initialize_current"
        },
        {
          "description": "修改项目显示名称，保留身份与路径。",
          "value": "rename"
        },
        {
          "description": "移动到同一集的目标分类。",
          "value": "move"
        },
        {
          "description": "核对 project_id 并 confirm=true，使用项目回收流程。",
          "value": "delete"
        },
        {
          "description": "按明确传入的布尔值修改启用、动态或并发开关。",
          "value": "set_state"
        }
      ],
      "permission_scope": "global_data",
      "permission_type": "tiance_data_write",
      "type": "string"
    },
    "call_name": {
      "description": "create_tool/initialize_current 的调用名；省略按项目 ID 生成，已有清单不会被覆盖。",
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "permission_type": "none",
      "type": "string"
    },
    "category_id": {
      "description": "创建/移动的真实分类 ID；list 可按分类筛选。",
      "minLength": 1,
      "permission_type": "none",
      "type": "string"
    },
    "confirm": {
      "const": true,
      "description": "确认已核对删除对象，delete 必须 true；将项目连同其会话和附件送入系统回收站，不能删除当前调用项目。",
      "permission_scope": "global_data",
      "permission_type": "tiance_data_delete",
      "type": "boolean"
    },
    "dynamic": {
      "description": "set_state 可修改的动态加载开关，未传入的开关不变。",
      "permission_type": "none",
      "type": "boolean"
    },
    "enabled": {
      "description": "set_state 可修改的启用开关，未传入的开关不变。",
      "permission_type": "none",
      "type": "boolean"
    },
    "name": {
      "description": "创建或重命名时的显示名称。",
      "maxLength": 160,
      "minLength": 1,
      "permission_type": "none",
      "type": "string"
    },
    "parallel": {
      "description": "set_state 可修改的并行执行开关，未传入的开关不变。",
      "permission_type": "none",
      "type": "boolean"
    },
    "project_id": {
      "description": "get/rename/move/delete/set_state 的目标项目 ID；不是名称或路径。initialize_current 不接受此参数。",
      "minLength": 1,
      "permission_type": "none",
      "type": "string"
    }
  },
  "required": [
    "action"
  ],
  "type": "object"
