{
  "description": "查看、创建、删除和整理工具，附制作文档；仅允许在工具集已登记项目根目录补齐标准内容，保留已有文件。新工具默认关闭。",
  "execution": {
    "parallel": false
  },
  "files": {
    "examples": ".tool/examples.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json",
    "permissions": ".tool/permissions.json"
  },
  "io": {
    "input": "client_json",
    "output": "client_json"
  },
  "loading": {
    "dynamic": true
  },
  "name": "create_blank_tool",
  "registration_name": "工具管理",
  "runtime": {
    "client_capability": {
      "min_version": 2,
      "name": "tool.projects"
    },
    "timeout_seconds": 180,
    "type": "client"
  },
  "state": {
    "enabled": true
  }
}
