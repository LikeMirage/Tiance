{
  "description": "查看或创建工具分类，生成配齐标准文件和制作资料的空白工具；创建后默认关闭。",
  "execution": {
    "parallel": false
  },
  "files": {
    "examples": ".tool/examples.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json",
    "permissions": ".tool/permissions.json"
  },
  "io": {
    "input": "client_json",
    "output": "client_json"
  },
  "loading": {
    "dynamic": true
  },
  "name": "create_blank_tool",
  "registration_name": "新建空白工具",
  "runtime": {
    "client_capability": {
      "min_version": 1,
      "name": "tool.projects"
    },
    "timeout_seconds": 180,
    "type": "client"
  },
  "state": {
    "enabled": true
  }
}
