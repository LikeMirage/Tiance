{
  "description": "通过后端与指定项目的 AI 会话协作，无需前端在线，适合 MCP 等远程调用。",
  "registration_name": "Tiance AI 会话桥",
  "execution": {
    "parallel": true
  },
  "files": {
    "examples": ".tool/examples.json",
    "permissions": ".tool/permissions.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "loading": {
    "dynamic": false
  },
  "name": "tiance_conversation_bridge",
  "runtime": {
    "entry": "program/main.py",
    "timeout_seconds": 900,
    "type": "python"
  },
  "state": {
    "enabled": true
  }
}
