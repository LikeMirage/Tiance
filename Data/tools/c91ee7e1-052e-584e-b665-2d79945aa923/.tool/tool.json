{
  "description": "用 MinerU 将文档解析为 Markdown，可结合 DeepSeek 视觉补充插图信息；适合扫描书、论文和报告。",
  "registration_name": "MinerU 文档解析 + DeepSeek 视觉",
  "execution": {
    "parallel": true
  },
  "files": {
    "examples": ".tool/examples.json",
    "permissions": ".tool/permissions.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "loading": {
    "dynamic": true
  },
  "name": "parse_document_mineru_dmx",
  "runtime": {
    "entry": "program/main.py",
    "timeout_seconds": 7200,
    "type": "python"
  },
  "state": {
    "enabled": true
  }
}
