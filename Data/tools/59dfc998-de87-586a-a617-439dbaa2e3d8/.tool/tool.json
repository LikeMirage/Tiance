{
  "description": "一次读取多个已知路径的工作区文本文件或图片；支持逐文件选择内容范围。",
  "registration_name": "批量读取文件",
  "execution": {
    "parallel": true
  },
  "files": {
    "examples": ".tool/examples.json",
    "permissions": ".tool/permissions.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "loading": {
    "dynamic": false
  },
  "name": "read_many_files",
  "runtime": {
    "entry": "program/main.py",
    "timeout_seconds": 60,
    "type": "python"
  },
  "state": {
    "enabled": true
  }
}
