{
  "description": "已知多个目标文本文件或图片并需要一次读取时使用；单个文件使用 read_file，尚不确定相关文件时使用 find_project_files。文本按单文件和总字符预算自动截断；图片复用文件读取工具的校验、视觉能力检测和缩放内核，默认生成 60% 临时派生图且不修改原图。",
  "registration_name": "批量读取文件",
  "execution": {
    "parallel": true
  },
  "files": {
    "examples": ".tool/examples.json","permissions":".tool/permissions.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "keywords": [
    "批量读取",
    "多文件",
    "上下文",
    "源码",
    "文档",
    "配置"
    ,"图片"
    ,"批量图片"
  ],
  "loading": {
    "dynamic": false
  },
  "name": "read_many_files",
  "runtime": {
    "entry": "program/main.py",
    "timeout_seconds": 60,
    "type": "python"
  },
  "state": {
    "enabled": true
  }
}
