{
  "description": "管理 GitHub Release 和附件。支持列表、详情、创建、编辑、删除发布，列出、上传、删除附件。附件 path 必须位于当前会话项目内；写操作可用 dry_run=true 模拟。",
  "execution": {
    "parallel": true
  },
  "files": {
    "examples": ".tool/examples.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json",
    "permissions": ".tool/permissions.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "keywords": [
    "GitHub",
    "Release",
    "发布",
    "版本",
    "附件"
  ],
  "loading": {
    "dynamic": true
  },
  "name": "github_release",
  "registration_name": "GitHub 发布",
  "runtime": {
    "entry": "program/main.py",
    "timeout_seconds": 1800,
    "type": "python"
  },
  "state": {
    "enabled": true
  }
}
