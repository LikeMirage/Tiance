{
  "description": "管理 GitHub Release 及其发布附件。",
  "execution": {
    "parallel": true
  },
  "files": {
    "examples": ".tool/examples.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json",
    "permissions": ".tool/permissions.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "loading": {
    "dynamic": true
  },
  "name": "github_release",
  "registration_name": "GitHub 发布",
  "runtime": {
    "entry": "program/main.py",
    "timeout_seconds": 1800,
    "type": "python",
    "host_capabilities": [
      "github_releases"
    ]
  },
  "state": {
    "enabled": true
  }
}
