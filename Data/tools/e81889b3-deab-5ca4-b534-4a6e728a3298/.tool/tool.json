{
  "description": "按文件路径模式查找工作区文件或目录。",
  "registration_name": "文件匹配",
  "execution": {
    "parallel": true
  },
  "files": {
    "examples": ".tool/examples.json",
    "permissions": ".tool/permissions.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "loading": {
    "dynamic": false
  },
  "name": "glob_files",
  "runtime": {
    "entry": "program/main.py",
    "timeout_seconds": 60,
    "type": "python"
  },
  "state": {
    "enabled": true
  }
}
