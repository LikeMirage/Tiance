{
  "description": "在项目文本中查找文字或正则表达式，返回命中行和附近上下文；适合精确定位。",
  "registration_name": "内容搜索",
  "execution": {
    "parallel": true
  },
  "files": {
    "examples": ".tool/examples.json",
    "permissions": ".tool/permissions.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "loading": {
    "dynamic": false
  },
  "name": "workspace_grep",
  "runtime": {
    "entry": "program/main.py",
    "timeout_seconds": 90,
    "type": "python"
  },
  "state": {
    "enabled": true
  }
}
