{
  "description": "已知要查找的文本或正则表达式，需要定位命中文件、行号及附近上下文时使用；目标文件已经明确且需要读取内容时使用 read_file 或 read_many_files。使用内置 ripgrep 高速搜索，支持大小写、编码、路径过滤、ignore 规则、文件大小限制、总结果截断和上下文行。",
  "display_name": "内容搜索",
  "execution": {
    "parallel": true
  },
  "files": {
    "examples": ".tool/examples.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "keywords": [
    "grep",
    "ripgrep",
    "rg",
    "搜索",
    "内容搜索",
    "正则",
    "源码",
    "关键词",
    "上下文"
  ],
  "loading": {
    "dynamic": false
  },
  "name": "workspace_grep",
  "runtime": {
    "entry": "program/main.py",
    "timeout_seconds": 90,
    "type": "python"
  },
  "state": {
    "enabled": true
  }
}
