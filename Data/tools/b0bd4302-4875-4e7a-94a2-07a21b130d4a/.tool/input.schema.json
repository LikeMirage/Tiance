{
  "type": "object",
  "additionalProperties": false,
  "required": ["action"],
  "properties": {
    "action": {
      "type": "string",
      "enum": ["overview", "status", "diff", "log", "show_commit", "fetch", "init", "connect_remote", "disconnect_remote", "create_branch", "switch_branch", "delete_branch", "list_tags", "create_tag", "delete_tag", "list_submodules", "add_submodule", "update_submodules", "commit", "push", "pull", "restore", "revert", "reset"]
    },
    "dry_run": {"type": "boolean", "default": false, "description": "写操作设为 true 时只校验并返回模拟结果，不修改项目或远端。"},
    "remote": {"type": "string", "default": "origin"},
    "repository": {"type": "string", "description": "GitHub 仓库 HTTPS 地址；连接远端或添加子模块时使用。"},
    "branch": {"type": "string"},
    "revision": {"type": "string", "description": "提交 SHA、分支或标签。"},
    "paths": {"type": "array", "items": {"type": "string"}, "maxItems": 5000},
    "staged": {"type": "boolean", "default": false},
    "force": {"type": "boolean", "default": false, "description": "push 时强制推送；reset 时硬重置；子模块更新时强制。"},
    "limit": {"type": "integer", "minimum": 1, "maximum": 100, "default": 30},
    "message": {"type": "string", "maxLength": 500},
    "tag": {"type": "string"},
    "submodulePath": {"type": "string"}
  }
}
