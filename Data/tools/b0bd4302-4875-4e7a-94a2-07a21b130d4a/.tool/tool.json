{
  "description": "管理当前普通项目的标准 Git 仓库。支持状态、差异、历史、远端、分支、标签、子模块、提交、推送、拉取、恢复、撤销和重置。仓库使用标准 .git，可与其他 Git 客户端互通；远程操作优先复用天策设定集中的 GitHub 登录。所有写操作都可先传 dry_run=true 模拟，模拟不会修改项目。",
  "display_name": "Git 仓库",
  "execution": {
    "parallel": false
  },
  "files": {
    "examples": ".tool/examples.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "keywords": [
    "Git",
    "GitHub",
    "版本控制",
    "提交",
    "推送",
    "拉取",
    "分支",
    "差异"
  ],
  "loading": {
    "dynamic": false
  },
  "name": "git_repository",
  "runtime": {
    "entry": "program/main.py",
    "timeout_seconds": 600,
    "type": "python"
  },
  "state": {
    "enabled": true
  }
}
