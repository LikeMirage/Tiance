{
  "description": "管理工作区 Git 仓库及提交、分支、远端同步。配置身份或认证时读取“提交身份与认证”。",
  "registration_name": "Git 仓库",
  "execution": {
    "parallel": true
  },
  "files": {
    "examples": ".tool/examples.json",
    "permissions": ".tool/permissions.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "loading": {
    "dynamic": true
  },
  "name": "git_repository",
  "runtime": {
    "entry": "program/main.py",
    "timeout_seconds": 600,
    "type": "python",
    "host_capabilities": [
      "git_repository"
    ]
  },
  "state": {
    "enabled": true
  }
}
