{
  "description": "通过统一入口执行当前会话已启用的动态工具，完整返回目标工具的结果。",
  "registration_name": "动态工具执行",
  "execution": {
    "parallel": true
  },
  "files": {
    "examples": ".tool/examples.json",
    "permissions": ".tool/permissions.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json"
  },
  "io": {
    "input": "internal_json",
    "output": "internal_json"
  },
  "loading": {
    "dynamic": false
  },
  "name": "execute_dynamic_tool",
  "runtime": {
    "entry": "execute_dynamic_tool",
    "timeout_seconds": 600,
    "type": "internal"
  },
  "state": {
    "enabled": true
  }
}
