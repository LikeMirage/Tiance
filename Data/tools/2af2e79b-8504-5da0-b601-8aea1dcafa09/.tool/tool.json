{
  "description": "使用 PyMuPDF 将工作区内 PDF 页面渲染为图片，支持页码范围、DPI/缩放、图片格式、色彩空间、透明背景、批注、裁剪区域、旋转、文本旁路文件和 manifest。",
  "display_name": "PDF 转图片",
  "execution": {
    "parallel": false
  },
  "files": {
    "examples": ".tool/examples.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "keywords": [
    "PDF",
    "转图片",
    "PyMuPDF",
    "渲染",
    "PNG",
    "JPG",
    "文档图片"
  ],
  "loading": {
    "dynamic": true
  },
  "name": "pdf_to_images_pymupdf",
  "runtime": {
    "entry": "program/main.py",
    "timeout_seconds": 600,
    "type": "python"
  },
  "state": {
    "enabled": true
  }
}
