{
  "additionalProperties": false,
  "description": "把 PDF 页面渲染为图片。file_path 必填；输出目录必须位于工作区内。页码使用 1 基序号，支持 page_ranges 如 all、1-3,5,last、2-、-10。",
  "properties": {
    "file_path": {
      "description": "PDF 文件路径。相对路径按工作区根目录解析，默认要求源文件在工作区内。",
      "title": "PDF 文件路径",
      "type": "string"
    },
    "output_root": {
      "description": "输出根目录。相对路径按工作区根目录解析；不填则输出到源 PDF 同级目录。",
      "title": "输出根目录",
      "type": "string"
    },
    "output_folder_name": {
      "description": "输出文件夹名。不填时使用 源文件名_images。",
      "title": "输出文件夹名",
      "type": "string"
    },
    "page_ranges": {
      "default": "all",
      "description": "页码范围，1 基序号。示例：all、1-3,5,last、2-、-10。",
      "title": "页码范围",
      "type": "string"
    },
    "pages": {
      "description": "页码数组，1 基序号。提供后会与 page_ranges 合并去重。",
      "items": {
        "type": "integer"
      },
      "maxItems": 1000,
      "title": "页码数组",
      "type": "array",
      "uniqueItems": true
    },
    "password": {
      "description": "加密 PDF 的打开密码。",
      "title": "PDF 密码",
      "type": "string"
    },
    "image_format": {
      "default": "png",
      "description": "输出图片格式。jpg/jpeg 适合较小文件；png 适合保真和透明背景；ppm/pam/pnm 适合特殊处理流程。",
      "enum": [
        "png",
        "jpg",
        "jpeg",
        "ppm",
        "pam",
        "pnm"
      ],
      "options": [
        {
          "description": "PNG，默认推荐。",
          "value": "png"
        },
        {
          "description": "JPEG，文件较小，不支持透明背景。",
          "value": "jpg"
        },
        {
          "description": "JPEG 的别名。",
          "value": "jpeg"
        },
        {
          "description": "PPM 原始位图格式。",
          "value": "ppm"
        },
        {
          "description": "PAM 原始位图格式。",
          "value": "pam"
        },
        {
          "description": "PNM 原始位图格式。",
          "value": "pnm"
        }
      ],
      "title": "图片格式",
      "type": "string"
    },
    "dpi": {
      "default": 200,
      "description": "渲染 DPI。提供 zoom/zoom_x/zoom_y 时，dpi 仍优先生效。",
      "maximum": 1200,
      "minimum": 36,
      "title": "DPI",
      "type": "integer"
    },
    "zoom": {
      "description": "统一缩放倍率。只有 dpi 为空时使用。",
      "maximum": 20,
      "minimum": 0.1,
      "title": "缩放倍率",
      "type": "number"
    },
    "zoom_x": {
      "description": "横向缩放倍率。只有 dpi 为空时使用。",
      "maximum": 20,
      "minimum": 0.1,
      "title": "横向缩放",
      "type": "number"
    },
    "zoom_y": {
      "description": "纵向缩放倍率。只有 dpi 为空时使用。",
      "maximum": 20,
      "minimum": 0.1,
      "title": "纵向缩放",
      "type": "number"
    },
    "colorspace": {
      "default": "rgb",
      "description": "输出色彩空间。",
      "enum": [
        "rgb",
        "gray",
        "cmyk"
      ],
      "options": [
        {
          "description": "RGB 彩色。",
          "value": "rgb"
        },
        {
          "description": "灰度。",
          "value": "gray"
        },
        {
          "description": "CMYK。",
          "value": "cmyk"
        }
      ],
      "title": "色彩空间",
      "type": "string"
    },
    "alpha": {
      "default": false,
      "description": "是否保留透明背景。JPEG 会自动关闭透明背景。",
      "title": "透明背景",
      "type": "boolean"
    },
    "include_annotations": {
      "default": true,
      "description": "是否渲染批注、标注等 annotation。",
      "title": "渲染批注",
      "type": "boolean"
    },
    "use_cropbox": {
      "default": true,
      "description": "是否按 PDF cropbox 渲染。false 时尽量按 mediabox 渲染完整页面。",
      "title": "使用 CropBox",
      "type": "boolean"
    },
    "clip": {
      "additionalProperties": false,
      "description": "裁剪区域，单位为 PDF point。只渲染该矩形区域。",
      "properties": {
        "x0": {
          "type": "number"
        },
        "y0": {
          "type": "number"
        },
        "x1": {
          "type": "number"
        },
        "y1": {
          "type": "number"
        }
      },
      "title": "裁剪区域",
      "type": "object"
    },
    "extra_rotation": {
      "default": 0,
      "description": "额外旋转角度，只支持 0、90、180、270。",
      "enum": [
        0,
        90,
        180,
        270
      ],
      "options": [
        {
          "description": "不额外旋转。",
          "value": 0
        },
        {
          "description": "顺时针 90 度。",
          "value": 90
        },
        {
          "description": "顺时针 180 度。",
          "value": 180
        },
        {
          "description": "顺时针 270 度。",
          "value": 270
        }
      ],
      "title": "额外旋转",
      "type": "integer"
    },
    "jpg_quality": {
      "default": 95,
      "description": "JPEG 质量，只有 jpg/jpeg 时生效。",
      "maximum": 100,
      "minimum": 1,
      "title": "JPEG 质量",
      "type": "integer"
    },
    "filename_pattern": {
      "default": "{stem}_page_{page:04d}.{ext}",
      "description": "输出文件名模板。可用字段：stem、page、page_index0、index、ext、width、height。",
      "title": "文件名模板",
      "type": "string"
    },
    "overwrite": {
      "default": false,
      "description": "输出目录已存在时是否覆盖。",
      "title": "覆盖输出",
      "type": "boolean"
    },
    "backup_existing": {
      "default": true,
      "description": "覆盖输出目录前是否把旧目录移动为时间戳备份。",
      "title": "备份旧目录",
      "type": "boolean"
    },
    "save_manifest": {
      "default": true,
      "description": "是否写入 manifest.json。",
      "title": "保存 Manifest",
      "type": "boolean"
    },
    "save_page_text": {
      "default": false,
      "description": "是否额外保存每页文本为 .txt 旁路文件。",
      "title": "保存页文本",
      "type": "boolean"
    },
    "continue_on_error": {
      "default": true,
      "description": "单页渲染失败时是否继续处理后续页面。",
      "title": "错误后继续",
      "type": "boolean"
    },
    "dry_run": {
      "default": false,
      "description": "只计算页码和输出路径，不实际渲染或写入图片。",
      "title": "预演",
      "type": "boolean"
    },
    "max_pages": {
      "default": 500,
      "description": "单次最多渲染页数。",
      "maximum": 5000,
      "minimum": 1,
      "title": "最大页数",
      "type": "integer"
    },
    "max_pixels": {
      "default": 100000000,
      "description": "单页最大像素数，避免过高 DPI 导致内存过大。",
      "maximum": 1000000000,
      "minimum": 1000000,
      "title": "单页最大像素",
      "type": "integer"
    }
  },
  "required": [
    "file_path"
  ],
  "type": "object"
}
