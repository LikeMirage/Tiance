{
  "description": "为天策工具或指定目录安装、检查、修复和卸载 Python 依赖。",
  "registration_name": "PIP 依赖管理",
  "execution": {
    "parallel": true
  },
  "files": {
    "examples": ".tool/examples.json",
    "permissions": ".tool/permissions.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "loading": {
    "dynamic": false
  },
  "name": "pip_package_manager",
  "runtime": {
    "entry": "program/main.py",
    "timeout_seconds": 660,
    "type": "python"
  },
  "state": {
    "enabled": true
  }
}
