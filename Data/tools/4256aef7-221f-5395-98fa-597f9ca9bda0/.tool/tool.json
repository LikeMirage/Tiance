{
  "description": "管理天策内置 Python 依赖，主要用于按工具名称或 ID 把依赖补齐到该工具自己的独立目录；支持主动安装、一键读取 requirements.txt、其他明确目录、检查、修复、查看和卸载。",
  "display_name": "PIP 依赖管理",
  "execution": {
    "parallel": true
  },
  "files": {
    "examples": ".tool/examples.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "keywords": [
    "PIP",
    "Python",
    "依赖",
    "工具依赖",
    "requirements.txt",
    "安装",
    "卸载",
    "环境检查",
    "权限修复",
    "包管理",
    "ModuleNotFoundError"
  ],
  "loading": {
    "dynamic": false
  },
  "name": "pip_package_manager",
  "runtime": {
    "entry": "program/main.py",
    "timeout_seconds": 660,
    "type": "python"
  },
  "state": {
    "enabled": true
  }
}
