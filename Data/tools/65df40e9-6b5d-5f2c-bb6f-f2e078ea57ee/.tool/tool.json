{
  "description": "为项目文本建立可增量更新的全文索引，适合反复检索较大的文档或代码集合。",
  "execution": {
    "parallel": true
  },
  "files": {
    "examples": ".tool/examples.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json",
    "permissions": ".tool/permissions.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "loading": {
    "dynamic": false
  },
  "name": "workspace_fulltext_search",
  "registration_name": "工作区全文检索",
  "runtime": {
    "entry": "program/main.py",
    "timeout_seconds": 1200,
    "type": "python"
  },
  "state": {
    "enabled": true
  }
}
