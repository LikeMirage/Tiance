{
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "type_text"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "text"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "press_key"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "key"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "hotkey"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "keys"
        ]
      }
    }
  ],
  "description": "先等待 gui_runtime start 成功；除列窗口外，操作使用 gui_inspect 建立的真实会话与最新观察结果。用户中断或解锁后须重新建立会话。完整流程及异常处理见本工具“操作流程与注意事项”。",
  "properties": {
    "screenshot_delay_seconds": {
      "type": "number",
      "minimum": 0,
      "maximum": 30,
      "default": 1,
      "description": "操作全部结束后等待再截图，默认1秒，可设0到30秒（含小数）；0立即截图，等待期间Esc立即取消。截图等待计入调用总时限。",
      "permission_type": "none"
    },
    "action": {
      "type": "string",
      "enum": [
        "type_text",
        "press_key",
        "hotkey"
      ],
      "description": "键盘动作。",
      "permission_type": "ui_control"
    },
    "gui_session_id": {
      "type": "string",
      "pattern": "^gui_[a-f0-9]{32}$",
      "permission_type": "none",
      "description": "gui_inspect start 实际返回的 GUI 会话 ID，不使用示例占位值。"
    },
    "text": {
      "type": "string",
      "maxLength": 100000,
      "description": "type_text输入的Unicode文本。",
      "permission_type": "none"
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "description": "press_key按键名，支持字母、数字、F1-F24及常用控制键。",
      "permission_type": "none"
    },
    "keys": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 2,
      "maxItems": 8,
      "description": "hotkey按下顺序，按相反顺序释放。",
      "permission_type": "none"
    },
    "presses": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "default": 1,
      "permission_type": "none",
      "description": "按键重复次数。"
    },
    "interval_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2000,
      "default": 20,
      "description": "文本字符或重复按键间隔。",
      "permission_type": "none"
    },
    "hold_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2000,
      "default": 0,
      "description": "hotkey全部按下后的保持时间。",
      "permission_type": "none"
    },
    "frame_id": {
      "type": "integer",
      "minimum": 0,
      "description": "实际观察过的最新Frame ID，不能自动使用后台新截图。",
      "permission_type": "none"
    }
  },
  "required": [
    "action",
    "gui_session_id",
    "frame_id"
  ],
  "type": "object"
}
