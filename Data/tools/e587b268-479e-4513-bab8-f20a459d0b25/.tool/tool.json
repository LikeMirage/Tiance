{
  "description": "向已确认的前台输入位置发送文本、按键和快捷键。首次使用前读取“操作流程与注意事项”。",
  "execution": {
    "parallel": false
  },
  "files": {
    "examples": ".tool/examples.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json",
    "permissions": ".tool/permissions.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "loading": {
    "dynamic": true
  },
  "name": "gui_keyboard",
  "registration_name": "GUI 键盘操作",
  "runtime": {
    "entry": "program/main.py",
    "timeout_seconds": 75,
    "type": "python"
  },
  "state": {
    "enabled": true
  }
}
