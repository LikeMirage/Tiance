{
  "description": "在锁定的Windows界面输入文本、按键或组合键。先调用gui_runtime start，再用gui_inspect取得GUI临时会话。执行前检查完整截图；变化达到阈值则返回最新Frame并停止操作。用户输入被拦截，按Esc立即中止并解锁。 操作结束后按screenshot_delay_seconds等待再截图，默认1秒、范围0到30秒。",
  "execution": {
    "parallel": false
  },
  "files": {
    "examples": ".tool/examples.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json",
    "permissions": ".tool/permissions.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "keywords": [
    "GUI",
    "键盘",
    "文本输入",
    "按键",
    "快捷键"
  ],
  "loading": {
    "dynamic": true
  },
  "name": "gui_keyboard",
  "registration_name": "GUI 键盘操作",
  "runtime": {
    "entry": "program/main.py",
    "timeout_seconds": 75,
    "type": "python"
  },
  "state": {
    "enabled": true
  }
}
