{
  "name": "github_actions",
  "registration_name": "GitHub Actions",
  "description": "查看 GitHub Actions 工作流、运行和日志，或触发、重跑、取消任务。",
  "execution": {
    "parallel": true
  },
  "loading": {
    "dynamic": true
  },
  "state": {
    "enabled": true
  },
  "runtime": {
    "type": "python",
    "entry": "program/main.py",
    "timeout_seconds": 1200,
    "host_capabilities": [
      "github_actions"
    ]
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "files": {
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json",
    "examples": ".tool/examples.json",
    "permissions": ".tool/permissions.json"
  }
}
