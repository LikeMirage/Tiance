{
  "description": "使用当前会话模型和供应商已保存的 API Key 调用供应商内置网络搜索。适合查询实时信息并返回模型基于搜索结果生成的答案、实际搜索词、来源、引用和供应商用量；模型或供应商不支持内置搜索时会明确失败，不会切换模型或改用其他搜索服务。",
  "registration_name": "模型内置网络搜索",
  "execution": {
    "parallel": true
  },
  "files": {
    "examples": ".tool/examples.json","permissions":".tool/permissions.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "keywords": [
    "网络搜索",
    "实时信息",
    "供应商内置工具",
    "Responses",
    "Google Search",
    "Anthropic Web Search"
  ],
  "loading": {
    "dynamic": true
  },
  "name": "network_search",
  "runtime": {
    "entry": "program/main.py",
    "timeout_seconds": 180,
    "type": "python"
  },
  "state": {
    "enabled": true
  }
}
