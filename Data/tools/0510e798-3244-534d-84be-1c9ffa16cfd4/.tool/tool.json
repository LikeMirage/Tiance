{
  "description": "让当前会话模型使用供应商内置网络搜索，返回带来源的回答；依赖该模型支持此能力。",
  "registration_name": "模型内置网络搜索",
  "execution": {
    "parallel": true
  },
  "files": {
    "examples": ".tool/examples.json",
    "permissions": ".tool/permissions.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "loading": {
    "dynamic": true
  },
  "name": "network_search",
  "runtime": {
    "entry": "program/main.py",
    "timeout_seconds": 180,
    "type": "python",
    "host_capabilities": [
      "web_search"
    ]
  },
  "state": {
    "enabled": true
  }
}
