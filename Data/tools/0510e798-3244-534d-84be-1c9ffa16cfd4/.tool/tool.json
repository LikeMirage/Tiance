{
  "description": "让当前会话模型使用供应商内置网络搜索，返回带来源的回答；依赖该模型支持此能力。",
  "registration_name": "模型内置网络搜索",
  "execution": {
    "parallel": true
  },
  "files": {
    "examples": ".tool/examples.json",
    "permissions": ".tool/permissions.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "loading": {
    "dynamic": true
  },
  "name": "network_search",
  "runtime": {
    "entry": "program/main.py",
    "timeout_seconds": 180,
    "type": "python",
    "host_capabilities": [
      "session_model"
    ],
    "session_model_endpoints": {
      "deepseek": {
        "protocol": "openai_responses",
        "url": "https://api.deepseek.com/v1/responses",
        "search": { "model_tools": {
          "deepseek-flash": "deepseek_web_search",
          "deepseek-v4-flash": "deepseek_web_search",
          "deepseek-v4-flash-vision-exp": "deepseek_web_search"
        } }
      },
      "openai": {
        "protocol": "openai_responses", "url": "https://api.openai.com/v1/responses",
        "search": { "include_sources": true }
      },
      "volcengine_beijing": { "protocol": "openai_responses", "url": "https://ark.cn-beijing.volces.com/api/v3/responses" },
      "anthropic": { "protocol": "anthropic_messages", "url": "https://api.anthropic.com/v1/messages" },
      "gemini": { "protocol": "gemini_generate_content", "url": "https://generativelanguage.googleapis.com/v1beta/models/{model}:{action}" },
      "responses_from_chat": { "protocol": "openai_responses", "url": "../responses" },
      "generic_responses": { "protocol": "openai_responses", "url": "responses" },
      "generic_messages": { "protocol": "anthropic_messages", "url": "messages" },
      "generic_gemini": { "protocol": "gemini_generate_content", "url": "./{model}:{action}" }
    },
    "model_usage_feature": "provider_web_search"
  },
  "state": {
    "enabled": true
  }
}
