{
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "summary": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "screenshot_delay_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 30,
          "description": "本次操作结束后实际采用的截图等待秒数；预览时见operation中的同名参数。"
        },
        "preview_id": {
          "type": "string"
        },
        "preview_status": {
          "type": "string",
          "enum": [
            "pending",
            "executed",
            "expired",
            "failed"
          ]
        },
        "preview_reused": {
          "type": "boolean",
          "description": "true表示返回该编号的历史结果，没有再次执行；图片不是重新截取的。"
        },
        "operation": {
          "type": "object",
          "description": "已保存的完整鼠标动作，包含实际生效的默认参数。"
        },
        "execution_status": {
          "type": "string",
          "enum": [
            "not_started",
            "partial",
            "completed"
          ],
          "description": "输入执行状态，不保证应用业务成功。completed表示动作已执行，后续截图失败也不会改成未执行。"
        },
        "performed": {
          "type": "boolean",
          "description": "是否执行过输入；错误时的执行进度见error_info.details。"
        },
        "input_events_sent": {
          "type": "integer",
          "minimum": 0
        },
        "observation_status": {
          "type": "string",
          "enum": [
            "captured",
            "unavailable"
          ],
          "description": "操作后截图取得与否；unavailable时重新观察，不要重放已完成动作。"
        },
        "observation_error": {
          "type": "object"
        },
        "frame_id": {
          "type": [
            "integer",
            "null"
          ],
          "description": "新截图编号；操作后未取得截图时为null，旧编号已失效。"
        },
        "foreground_window": {
          "type": "object",
          "description": "截图时或观察失败后的实际前台窗口：hwnd、process_id、title、rect、exists；不会自动切换截图目标。"
        },
        "foreground_changed": {
          "type": "boolean"
        }
      }
    },
    "content": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error": {
      "type": "string"
    },
    "error_info": {
      "type": "object"
    }
  },
  "required": [
    "ok"
  ]
}
