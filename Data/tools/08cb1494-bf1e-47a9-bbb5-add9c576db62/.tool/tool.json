{
  "description": "根据已观察的截图网格执行鼠标移动、点击、拖动和滚动。首次使用前读取“操作流程与注意事项”。",
  "execution": {
    "parallel": false
  },
  "files": {
    "examples": ".tool/examples.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json",
    "permissions": ".tool/permissions.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "loading": {
    "dynamic": true
  },
  "name": "gui_mouse",
  "registration_name": "GUI 鼠标操作",
  "runtime": {
    "entry": "program/main.py",
    "timeout_seconds": 75,
    "type": "python"
  },
  "state": {
    "enabled": true
  }
}
