{
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "execute_preview"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "preview_id"
        ],
        "maxProperties": 2
      },
      "else": {
        "required": [
          "gui_session_id",
          "frame_id"
        ],
        "oneOf": [
          {
            "required": [
              "element_id"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "view_id"
                  ]
                },
                {
                  "required": [
                    "cell_id"
                  ]
                },
                {
                  "required": [
                    "x"
                  ]
                },
                {
                  "required": [
                    "y"
                  ]
                }
              ]
            }
          },
          {
            "required": [
              "view_id",
              "cell_id",
              "x",
              "y"
            ],
            "not": {
              "required": [
                "element_id"
              ]
            }
          }
        ],
        "not": {
          "required": [
            "preview_id"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "preview"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "preview_action"
        ]
      },
      "else": {
        "not": {
          "required": [
            "preview_action"
          ]
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "action": {
                "const": "drag"
              }
            },
            "required": [
              "action"
            ]
          },
          {
            "properties": {
              "action": {
                "const": "preview"
              },
              "preview_action": {
                "const": "drag"
              }
            },
            "required": [
              "action",
              "preview_action"
            ]
          }
        ]
      },
      "then": {
        "required": [
          "to"
        ]
      }
    }
  ],
  "description": "先调用gui_runtime start并等待成功锁定，再用gui_inspect start取得截图会话和坐标依据。在锁定界面直接执行click、scroll等鼠标动作，preview仅是可选落点确认。x/y接受任意小数，如0.5037，不限两位，最终取整到屏幕像素；原点在格子左下角。也可引用gui_inspect elements返回的element_id，执行前重新核对控件身份和状态，按当前矩形定位。expected_elements可核查会话对象、输入内容等调用方指定条件。预览编号一次执行。drag不比较截图像素、不使用变化阈值，改为核对截图时的起点窗口身份、位置和遮挡；窗口变化时刷新后重新定位，完成后返回新截图。其他动作保留原有变化检查。",
  "properties": {
    "screenshot_delay_seconds": {
      "type": "number",
      "minimum": 0,
      "maximum": 30,
      "default": 1,
      "description": "操作全部结束后等待再截图，默认1秒，可设0到30秒（含小数）；0立即截图，等待期间Esc立即取消。批量只在末尾等待一次；预览不等待，参数随预览保存，执行编号时不可覆盖。截图等待计入调用总时限。",
      "permission_type": "none"
    },
    "action": {
      "type": "string",
      "enum": [
        "preview",
        "execute_preview",
        "move",
        "click",
        "drag",
        "scroll",
        "mouse_down",
        "mouse_up"
      ],
      "description": "preview预览并保存完整鼠标动作；execute_preview按编号执行；其他值直接执行。",
      "permission_type": "ui_control"
    },
    "preview_action": {
      "type": "string",
      "enum": [
        "move",
        "click",
        "drag",
        "scroll",
        "mouse_down",
        "mouse_up"
      ],
      "description": "仅preview使用且必填。点击类型由button/clicks决定，拖动展示起终点和路径，滚动展示落点和方向。",
      "permission_type": "none"
    },
    "preview_id": {
      "type": "string",
      "pattern": "^preview_[a-f0-9]{32}_[a-f0-9]{32}$",
      "description": "execute_preview必填，使用预览结果原样返回的编号；同一次界面锁内有效，重复提交只返回原执行结果，不再操作。",
      "permission_type": "none"
    },
    "gui_session_id": {
      "type": "string",
      "pattern": "^gui_[a-f0-9]{32}$",
      "permission_type": "none"
    },
    "frame_id": {
      "type": "integer",
      "minimum": 0,
      "description": "实际观察过的最新Frame ID；frame_id与view_id必须来自同一个Frame，操作后使用返回的新Frame，不能沿用旧Frame的放大View。",
      "permission_type": "none"
    },
    "view_id": {
      "type": "string",
      "minLength": 1,
      "description": "当前frame_id中已实际返回的View ID；新Frame最初只有root，需先重新zoom才能使用其放大View。",
      "permission_type": "none"
    },
    "cell_id": {
      "type": "integer",
      "minimum": 1,
      "description": "输入view_id已有网格中的Cell ID。",
      "permission_type": "none"
    },
    "x": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Cell内从左到右比例。 支持任意小数，不限制两位；最终取整到屏幕像素。",
      "permission_type": "none"
    },
    "y": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Cell内从下到上比例。 支持任意小数，不限制两位；最终取整到屏幕像素。",
      "permission_type": "none"
    },
    "to": {
      "type": "object",
      "additionalProperties": false,
      "description": "drag或preview_action=drag的终点，仍使用同一最新Frame。",
      "properties": {
        "view_id": {
          "type": "string",
          "minLength": 1
        },
        "cell_id": {
          "type": "integer",
          "minimum": 1
        },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "element_id": {
          "type": "string",
          "minLength": 1,
          "description": "gui_inspect elements返回的控件引用，仅当前Frame有效。",
          "permission_type": "none"
        }
      },
      "oneOf": [
        {
          "required": [
            "element_id"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "view_id"
                ]
              },
              {
                "required": [
                  "cell_id"
                ]
              },
              {
                "required": [
                  "x"
                ]
              },
              {
                "required": [
                  "y"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "view_id",
            "cell_id",
            "x",
            "y"
          ],
          "not": {
            "required": [
              "element_id"
            ]
          }
        }
      ]
    },
    "button": {
      "type": "string",
      "enum": [
        "left",
        "right",
        "middle"
      ],
      "default": "left",
      "permission_type": "none"
    },
    "clicks": {
      "type": "integer",
      "enum": [
        1,
        2
      ],
      "default": 1,
      "permission_type": "none"
    },
    "click_hold_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2000,
      "default": 80,
      "description": "每次click按下到抬起的时长，默认80毫秒。",
      "permission_type": "none"
    },
    "modifiers": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "ctrl",
          "shift",
          "alt",
          "win"
        ]
      },
      "uniqueItems": true,
      "maxItems": 4,
      "default": [],
      "permission_type": "none"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000,
      "default": 0,
      "description": "move/drag持续时间，0表示立即移动；定位后最多等待250毫秒校验实际光标位置，不一致则停止操作。",
      "permission_type": "none"
    },
    "direction": {
      "type": "string",
      "enum": [
        "up",
        "down",
        "left",
        "right"
      ],
      "default": "down",
      "permission_type": "none"
    },
    "notches": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 3,
      "permission_type": "none"
    },
    "interval_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2000,
      "default": 120,
      "description": "双击或滚动事件间隔。",
      "permission_type": "none"
    },
    "change_check_scope": {
      "type": "string",
      "enum": [
        "target_cell",
        "frame"
      ],
      "default": "target_cell",
      "description": "非drag动作的操作前检查范围：target_cell比较选定格子，frame比较完整截图。drag忽略此参数，核对起点窗口身份、位置和遮挡，不比较像素。",
      "permission_type": "none"
    },
    "change_threshold_percent": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 100,
      "default": 0.5,
      "description": "非drag动作检查范围内变化像素达到该百分比则阻断并返回最新Frame；任一RGB通道变化达到16的像素计为变化。drag不使用此阈值，无需提高阈值重试拖动。",
      "permission_type": "none"
    },
    "element_id": {
      "type": "string",
      "minLength": 1,
      "description": "gui_inspect elements返回的控件引用，仅当前Frame有效。",
      "permission_type": "none"
    },
    "expected_elements": {
      "type": "array",
      "description": "逐个核查指定控件；不符合即停止。可检查收件人名称、输入框内容、焦点或选中状态。",
      "permission_type": "none",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "element_id"
        ],
        "properties": {
          "element_id": {
            "type": "string",
            "minLength": 1,
            "description": "gui_inspect elements返回的控件引用，仅当前Frame有效。",
            "permission_type": "none"
          },
          "name": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "focused": {
            "type": "boolean"
          },
          "selected": {
            "type": "boolean"
          },
          "enabled": {
            "type": "boolean"
          },
          "offscreen": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "required": [
    "action"
  ],
  "type": "object"
}
