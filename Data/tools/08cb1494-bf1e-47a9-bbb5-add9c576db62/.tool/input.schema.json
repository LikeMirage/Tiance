{
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "execute_preview"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "preview_id"
        ],
        "maxProperties": 2
      },
      "else": {
        "required": [
          "gui_session_id",
          "frame_id",
          "view_id",
          "cell_id",
          "x",
          "y"
        ],
        "not": {
          "required": [
            "preview_id"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "preview"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "preview_action"
        ]
      },
      "else": {
        "not": {
          "required": [
            "preview_action"
          ]
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "action": {
                "const": "drag"
              }
            },
            "required": [
              "action"
            ]
          },
          {
            "properties": {
              "action": {
                "const": "preview"
              },
              "preview_action": {
                "const": "drag"
              }
            },
            "required": [
              "action",
              "preview_action"
            ]
          }
        ]
      },
      "then": {
        "required": [
          "to"
        ]
      }
    }
  ],
  "description": "先等待 gui_runtime start 成功；除列窗口外，操作使用 gui_inspect 建立的真实会话与最新观察结果。用户中断或解锁后须重新建立会话。完整流程及异常处理见本工具“操作流程与注意事项”。",
  "properties": {
    "screenshot_delay_seconds": {
      "type": "number",
      "minimum": 0,
      "maximum": 30,
      "default": 1,
      "description": "操作全部结束后等待再截图，默认1秒，可设0到30秒（含小数）；0立即截图，等待期间Esc立即取消。批量只在末尾等待一次；预览不等待，参数随预览保存，执行编号时不可覆盖。截图等待计入调用总时限。",
      "permission_type": "none"
    },
    "action": {
      "type": "string",
      "enum": [
        "preview",
        "execute_preview",
        "move",
        "click",
        "drag",
        "scroll",
        "mouse_down",
        "mouse_up"
      ],
      "description": "preview预览并保存完整鼠标动作；execute_preview按编号执行且只接受action、preview_id两个字段，其他参数必须在preview阶段设置；其他值直接执行。",
      "permission_type": "ui_control"
    },
    "preview_action": {
      "type": "string",
      "enum": [
        "move",
        "click",
        "drag",
        "scroll",
        "mouse_down",
        "mouse_up"
      ],
      "description": "仅preview使用且必填。点击类型由button/clicks决定，拖动展示起终点和路径，滚动展示落点和方向。",
      "permission_type": "none"
    },
    "preview_id": {
      "type": "string",
      "pattern": "^preview_[a-f0-9]{32}_[a-f0-9]{32}$",
      "description": "execute_preview必填，使用预览结果原样返回的编号；同一次界面锁内有效，重复提交只返回原执行结果，不再操作。",
      "permission_type": "none"
    },
    "gui_session_id": {
      "type": "string",
      "pattern": "^gui_[a-f0-9]{32}$",
      "permission_type": "none",
      "description": "gui_inspect start 实际返回的 GUI 会话 ID，不使用示例占位值。"
    },
    "frame_id": {
      "type": "integer",
      "minimum": 0,
      "description": "实际观察过的最新Frame ID；frame_id与view_id必须来自同一个Frame，操作后使用返回的新Frame，不能沿用旧Frame的放大View。",
      "permission_type": "none"
    },
    "view_id": {
      "type": "string",
      "minLength": 1,
      "description": "当前frame_id中已实际返回的View ID；新Frame最初只有root，需先重新zoom才能使用其放大View。",
      "permission_type": "none"
    },
    "cell_id": {
      "type": "integer",
      "minimum": 1,
      "description": "输入view_id已有网格中的Cell ID。",
      "permission_type": "none"
    },
    "x": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Cell内从左到右比例。 支持任意小数，不限制两位；最终取整到屏幕像素。",
      "permission_type": "none"
    },
    "y": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Cell内从下到上比例。 支持任意小数，不限制两位；最终取整到屏幕像素。",
      "permission_type": "none"
    },
    "to": {
      "type": "object",
      "additionalProperties": false,
      "description": "drag或preview_action=drag的终点，仍使用同一最新Frame。",
      "properties": {
        "view_id": {
          "type": "string",
          "minLength": 1
        },
        "cell_id": {
          "type": "integer",
          "minimum": 1
        },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "view_id",
        "cell_id",
        "x",
        "y"
      ]
    },
    "button": {
      "type": "string",
      "enum": [
        "left",
        "right",
        "middle"
      ],
      "default": "left",
      "permission_type": "none",
      "description": "鼠标按钮。"
    },
    "clicks": {
      "type": "integer",
      "enum": [
        1,
        2
      ],
      "default": 1,
      "permission_type": "none",
      "description": "单击或双击。"
    },
    "click_hold_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2000,
      "default": 80,
      "description": "每次click按下到抬起的时长，默认80毫秒。",
      "permission_type": "none"
    },
    "modifiers": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "ctrl",
          "shift",
          "alt",
          "win"
        ]
      },
      "uniqueItems": true,
      "maxItems": 4,
      "default": [],
      "permission_type": "none",
      "description": "鼠标动作期间同时按住的修饰键。"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000,
      "default": 0,
      "description": "move/drag持续时间，0表示立即移动；定位后最多等待250毫秒校验实际光标位置，不一致则停止操作。",
      "permission_type": "none"
    },
    "direction": {
      "type": "string",
      "enum": [
        "up",
        "down",
        "left",
        "right"
      ],
      "default": "down",
      "permission_type": "none",
      "description": "scroll 的滚动方向。"
    },
    "notches": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 3,
      "permission_type": "none",
      "description": "scroll 的滚动刻度数。"
    },
    "interval_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2000,
      "default": 120,
      "description": "双击或滚动事件间隔。",
      "permission_type": "none"
    }
  },
  "required": [
    "action"
  ],
  "type": "object"
}
