{
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "execute_preview"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "preview_id"
        ],
        "maxProperties": 2
      },
      "else": {
        "required": [
          "gui_session_id",
          "frame_id",
          "view_id",
          "cell_id",
          "x",
          "y"
        ],
        "not": {
          "required": [
            "preview_id"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "preview"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "preview_action"
        ]
      },
      "else": {
        "not": {
          "required": [
            "preview_action"
          ]
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "action": {
                "const": "drag"
              }
            },
            "required": [
              "action"
            ]
          },
          {
            "properties": {
              "action": {
                "const": "preview"
              },
              "preview_action": {
                "const": "drag"
              }
            },
            "required": [
              "action",
              "preview_action"
            ]
          }
        ]
      },
      "then": {
        "required": [
          "to"
        ]
      }
    }
  ],
  "description": "【最短持锁】只在当前GUI操作及必要界面确认期间持锁。当前GUI阶段结束，或下一步不再需要GUI时，立即gui_runtime stop并核实释放；等待用户、失败或取消时也先解锁，不等整件任务结束或空闲超时。如需切换展示窗口，最多尝试一次，随后立即stop，不以切换成功作为解锁前提。解锁后继续GUI操作须重新gui_runtime start并用gui_inspect start建立新会话，不沿用旧Frame、预览或控件引用。 先调用gui_runtime start并等待成功锁定，再用gui_inspect start取得截图会话和坐标依据。直接执行click、scroll等鼠标动作，preview仅为可选落点确认，预览编号只执行一次。x/y接受任意小数，例如0.5037，最终取整到屏幕像素；格内原点在左下角，y向上。动作不因画面像素变化而拦截；保留最新Frame、窗口身份和尺寸检查，drag还核对起点窗口的位置与遮挡。操作后返回新截图和当前前台窗口；execution_status只表示输入是否完成，observation_status单独表示截图是否取得。输入已完成但截图失败时，不要重放动作，先重新观察。 GUI操作中收到用户新消息，表示用户已解除锁定并暂停上一轮AI对话；如需继续操作，必须重新调用gui_runtime start并等待成功，再调用gui_inspect start建立新会话并重新观察，不沿用旧会话、Frame、预览或控件引用。 输入前确认目标前台，必要时先gui_inspect activate或start（target=window、真实hwnd、activate=true），再使用新Frame；已有菜单及所属弹窗遵循owner规则，避免反复激活主窗口。execute_preview只传action和preview_id；screenshot_delay_seconds在preview阶段设置并随动作保存，执行阶段不得补传或覆盖。需要继续观察变化或稳定时使用gui_inspect wait，画面稳定不代表业务成功。表单按钮、输入框、列表项能由UIA定位且支持相应pattern时优先gui_uia；纯视觉、canvas或未暴露控件的界面用坐标。",
  "properties": {
    "screenshot_delay_seconds": {
      "type": "number",
      "minimum": 0,
      "maximum": 30,
      "default": 1,
      "description": "操作全部结束后等待再截图，默认1秒，可设0到30秒（含小数）；0立即截图，等待期间Esc立即取消。批量只在末尾等待一次；预览不等待，参数随预览保存，执行编号时不可覆盖。截图等待计入调用总时限。",
      "permission_type": "none"
    },
    "action": {
      "type": "string",
      "enum": [
        "preview",
        "execute_preview",
        "move",
        "click",
        "drag",
        "scroll",
        "mouse_down",
        "mouse_up"
      ],
      "description": "preview预览并保存完整鼠标动作；execute_preview按编号执行且只接受action、preview_id两个字段，其他参数必须在preview阶段设置；其他值直接执行。",
      "permission_type": "ui_control"
    },
    "preview_action": {
      "type": "string",
      "enum": [
        "move",
        "click",
        "drag",
        "scroll",
        "mouse_down",
        "mouse_up"
      ],
      "description": "仅preview使用且必填。点击类型由button/clicks决定，拖动展示起终点和路径，滚动展示落点和方向。",
      "permission_type": "none"
    },
    "preview_id": {
      "type": "string",
      "pattern": "^preview_[a-f0-9]{32}_[a-f0-9]{32}$",
      "description": "execute_preview必填，使用预览结果原样返回的编号；同一次界面锁内有效，重复提交只返回原执行结果，不再操作。",
      "permission_type": "none"
    },
    "gui_session_id": {
      "type": "string",
      "pattern": "^gui_[a-f0-9]{32}$",
      "permission_type": "none"
    },
    "frame_id": {
      "type": "integer",
      "minimum": 0,
      "description": "实际观察过的最新Frame ID；frame_id与view_id必须来自同一个Frame，操作后使用返回的新Frame，不能沿用旧Frame的放大View。",
      "permission_type": "none"
    },
    "view_id": {
      "type": "string",
      "minLength": 1,
      "description": "当前frame_id中已实际返回的View ID；新Frame最初只有root，需先重新zoom才能使用其放大View。",
      "permission_type": "none"
    },
    "cell_id": {
      "type": "integer",
      "minimum": 1,
      "description": "输入view_id已有网格中的Cell ID。",
      "permission_type": "none"
    },
    "x": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Cell内从左到右比例。 支持任意小数，不限制两位；最终取整到屏幕像素。",
      "permission_type": "none"
    },
    "y": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Cell内从下到上比例。 支持任意小数，不限制两位；最终取整到屏幕像素。",
      "permission_type": "none"
    },
    "to": {
      "type": "object",
      "additionalProperties": false,
      "description": "drag或preview_action=drag的终点，仍使用同一最新Frame。",
      "properties": {
        "view_id": {
          "type": "string",
          "minLength": 1
        },
        "cell_id": {
          "type": "integer",
          "minimum": 1
        },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "view_id",
        "cell_id",
        "x",
        "y"
      ]
    },
    "button": {
      "type": "string",
      "enum": [
        "left",
        "right",
        "middle"
      ],
      "default": "left",
      "permission_type": "none"
    },
    "clicks": {
      "type": "integer",
      "enum": [
        1,
        2
      ],
      "default": 1,
      "permission_type": "none"
    },
    "click_hold_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2000,
      "default": 80,
      "description": "每次click按下到抬起的时长，默认80毫秒。",
      "permission_type": "none"
    },
    "modifiers": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "ctrl",
          "shift",
          "alt",
          "win"
        ]
      },
      "uniqueItems": true,
      "maxItems": 4,
      "default": [],
      "permission_type": "none"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000,
      "default": 0,
      "description": "move/drag持续时间，0表示立即移动；定位后最多等待250毫秒校验实际光标位置，不一致则停止操作。",
      "permission_type": "none"
    },
    "direction": {
      "type": "string",
      "enum": [
        "up",
        "down",
        "left",
        "right"
      ],
      "default": "down",
      "permission_type": "none"
    },
    "notches": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 3,
      "permission_type": "none"
    },
    "interval_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2000,
      "default": 120,
      "description": "双击或滚动事件间隔。",
      "permission_type": "none"
    }
  },
  "required": [
    "action"
  ],
  "type": "object"
}
