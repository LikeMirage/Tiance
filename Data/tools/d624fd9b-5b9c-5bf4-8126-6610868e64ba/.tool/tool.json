{
  "description": "查询、创建和管理当前项目的 AI 会话及模型配置，支持后台自动命名；发送任务使用 interact_ai_conversation。",
  "execution": {
    "parallel": true
  },
  "files": {
    "examples": ".tool/examples.json",
    "permissions": ".tool/permissions.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json"
  },
  "io": {
    "input": "client_json",
    "output": "client_json"
  },
  "loading": {
    "dynamic": false
  },
  "name": "manage_ai_conversations",
  "registration_name": "AI 会话管理",
  "runtime": {
    "client_capability": {
      "min_version": 1,
      "name": "conversation.management"
    },
    "timeout_seconds": 600,
    "type": "client"
  },
  "state": {
    "enabled": true
  }
}
