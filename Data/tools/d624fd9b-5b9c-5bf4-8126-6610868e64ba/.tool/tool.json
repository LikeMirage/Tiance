{
  "description": "查看和管理可递归的会话层级，创建空白或复刻的 AI 子会话，选择角色并覆盖配置，预览及删除指定会话。",
  "execution": {
    "parallel": true
  },
  "files": {
    "examples": ".tool/examples.json",
    "permissions": ".tool/permissions.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json"
  },
  "io": {
    "input": "client_json",
    "output": "client_json"
  },
  "loading": {
    "dynamic": false
  },
  "name": "manage_ai_conversations",
  "registration_name": "AI 会话管理",
  "runtime": {
    "client_capability": {
      "min_version": 3,
      "name": "conversation.management"
    },
    "timeout_seconds": 600,
    "type": "client"
  },
  "state": {
    "enabled": true
  }
}
