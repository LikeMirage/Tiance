{
  "additionalProperties": false,
  "description": "会话查询返回与界面一致的父子层级和分组；删除预览返回明确清单和预计归属；执行成功返回实际提交并已删除的 ID，不返回整批会话配置或历史。",
  "oneOf": [
    {
      "properties": {
        "ok": {
          "const": false
        }
      },
      "required": [
        "error"
      ]
    },
    {
      "properties": {
        "ok": {
          "const": true
        },
        "action": {
          "const": "query_models"
        }
      },
      "required": [
        "count",
        "providers",
        "models"
      ]
    },
    {
      "properties": {
        "ok": {
          "const": true
        },
        "action": {
          "const": "list_sessions"
        }
      },
      "required": [
        "project_id",
        "count",
        "active_session_id",
        "caller_session_id",
        "scope",
        "relation_depth",
        "sessions",
        "anchor_session_id",
        "group_filter",
        "status_filter"
      ]
    },
    {
      "properties": {
        "ok": {
          "const": true
        },
        "action": {
          "const": "get_session_info"
        }
      },
      "required": [
        "project_id",
        "session",
        "relationship"
      ]
    },
    {
      "properties": {
        "ok": {
          "const": true
        },
        "action": {
          "const": "get_session"
        }
      },
      "required": [
        "project_id",
        "session_id",
        "title",
        "runtime_status",
        "message_depth",
        "message_format",
        "messages",
        "loaded_message_count",
        "history_exhausted",
        "usage",
        "history_locator"
      ]
    },
    {
      "properties": {
        "ok": {
          "const": true
        },
        "action": {
          "enum": [
            "create_session",
            "configure_session"
          ]
        }
      },
      "required": [
        "project_id",
        "session",
        "runtime_status",
        "history_locator"
      ]
    },
    {
      "properties": {
        "ok": {
          "const": true
        },
        "action": {
          "const": "stop_session"
        }
      },
      "required": [
        "project_id",
        "stopped_session_id",
        "runtime_status",
        "history_locator"
      ]
    },
    {
      "properties": {
        "ok": {
          "const": true
        },
        "action": {
          "const": "delete_session"
        }
      },
      "required": [
        "project_id",
        "count",
        "target_session_ids",
        "include_descendants",
        "deleted_session_ids"
      ]
    },
    {
      "properties": {
        "ok": {
          "const": true
        },
        "action": {
          "const": "show_session"
        }
      },
      "required": [
        "project_id",
        "session_id",
        "shown",
        "runtime_status",
        "history_locator"
      ]
    },
    {
      "properties": {
        "ok": {
          "const": true
        },
        "action": {
          "const": "preview_delete"
        }
      },
      "required": [
        "project_id",
        "target_session_ids",
        "include_descendants",
        "session_ids",
        "count",
        "sessions",
        "reparented_sessions"
      ]
    }
  ],
  "properties": {
    "ok": {
      "description": "动作是否成功。",
      "type": "boolean"
    },
    "action": {
      "description": "实际执行的动作。",
      "type": "string"
    },
    "project_id": {
      "description": "动作所属项目 ID。",
      "type": "string"
    },
    "count": {
      "description": "本次返回的供应商、模型或会话数量。",
      "minimum": 0,
      "type": "integer"
    },
    "active_session_id": {
      "description": "聊天面板当前显示的会话 ID；没有活动会话时为 null。",
      "type": [
        "string",
        "null"
      ]
    },
    "caller_session_id": {
      "description": "实际发起工具调用的会话，与界面 active_session_id、指定关系中心无关。",
      "type": [
        "string",
        "null"
      ]
    },
    "scope": {
      "description": "list_sessions 实际使用的查看范围。",
      "enum": [
        "related",
        "all",
        "roots",
        "children",
        "descendants"
      ],
      "type": "string"
    },
    "relation_depth": {
      "description": "related/descendants 的最大关系深度；省略时 null 表示不限。其他范围为 null。",
      "minimum": 1,
      "type": [
        "integer",
        "null"
      ]
    },
    "providers": {
      "description": "query_models 返回的供应商列表，包含供应商标识、名称和可用于对话的模型数量。",
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "models": {
      "description": "query_models 返回的对话模型，包含所属供应商、模型标识、名称和能力标签。",
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "runtime_capabilities": {
      "description": "query_models 精确指定供应商和模型时返回的运行能力，包括可选推理模式、支持的采样参数、最大输出范围、工具调用和输入输出能力。",
      "type": "object"
    },
    "sessions": {
      "description": "list_sessions 或 preview_delete 的会话摘要。层级以当前存活父链为准，配置与消息按需单独读取。",
      "items": {
        "additionalProperties": false,
        "properties": {
          "session_id": {
            "description": "会话 ID。",
            "type": "string"
          },
          "title": {
            "description": "执行 list_sessions 时实时取得的会话名称。",
            "type": "string"
          },
          "runtime_status": {
            "description": "会话当前运行状态。",
            "enum": [
              "idle",
              "running",
              "error"
            ],
            "type": "string"
          },
          "parent_session_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "当前可见父会话 ID；null 为顶层。父级可能不在本次筛选结果中。"
          },
          "group": {
            "type": "string",
            "enum": [
              "root",
              "child",
              "fork",
              "automatic_naming",
              "memory_compaction",
              "project_memory_management",
              "global_memory_management"
            ],
            "description": "当前界面的具体分组。"
          },
          "depth": {
            "type": "integer",
            "minimum": 0,
            "description": "从当前项目顶层开始的会话层数，顶层为 0，分类折叠标题不计一层。"
          },
          "display_number": {
            "type": [
              "integer",
              "null"
            ],
            "description": "当前同组显示编号，只供用户定位，不是 ID。"
          },
          "relation_kind": {
            "type": "string",
            "description": "持久化的来源关系 root/child/fork/functional；提升为顶层后仍可保留原关系类型。"
          },
          "function_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_by": {
            "type": [
              "string",
              "null"
            ]
          },
          "child_count": {
            "type": "integer",
            "minimum": 0,
            "description": "所有分类的直属下级总数，未受本次查询筛选影响。"
          }
        },
        "required": [
          "session_id",
          "title",
          "runtime_status",
          "parent_session_id",
          "group",
          "depth",
          "display_number",
          "relation_kind",
          "function_type",
          "created_by",
          "child_count"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "session": {
      "description": "get_session_info 返回的会话详细属性，或创建、配置动作完成后的最新会话信息。",
      "type": "object"
    },
    "relationship": {
      "description": "get_session_info 返回的会话关系节点。relation_kind 区分 root、child、fork 和 functional；created_by 表示用户、AI 或系统创建；parent_session 包含父会话实时名称和 ID。旧会话尚无关系节点时为 null。",
      "type": [
        "object",
        "null"
      ]
    },
    "runtime_status": {
      "description": "目标会话当前运行状态。",
      "enum": [
        "idle",
        "running",
        "error"
      ],
      "type": "string"
    },
    "session_id": {
      "description": "get_session 读取或 show_session 已显示的目标会话 ID。",
      "type": "string"
    },
    "title": {
      "description": "目标会话执行查询时实时取得的名称。",
      "type": "string"
    },
    "shown": {
      "description": "聊天面板是否已显示目标会话。",
      "type": "boolean"
    },
    "messages": {
      "description": "get_session 按 message_depth 取得的最近已完成轮次，按时间从旧到新排列。done 和 error 计入完成轮次；running、无回复和 cancelled 不计入。结构由 message_format 决定。",
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "message_depth": {
      "description": "get_session 实际返回的已完成轮次数。",
      "minimum": 0,
      "type": "integer"
    },
    "message_format": {
      "description": "get_session 使用的消息返回形式。",
      "enum": [
        "content_only",
        "full"
      ],
      "type": "string"
    },
    "loaded_message_count": {
      "description": "为满足 message_depth 实际通过分页读取的原始消息数量。",
      "minimum": 0,
      "type": "integer"
    },
    "history_exhausted": {
      "description": "是否已经读取到该会话历史起点；false 表示达到所需完成轮次后停止继续向前翻页。",
      "type": "boolean"
    },
    "usage": {
      "description": "目标会话累计 token、缓存命中与未命中、推理 token、费用、记录数和分模型用量。",
      "type": "object"
    },
    "history_locator": {
      "additionalProperties": false,
      "description": "原始历史的稳定定位信息。需要检索完整历史时，调用指定工具并传入该会话 ID。",
      "properties": {
        "tool_name": {
          "const": "conversation_history_search",
          "type": "string"
        },
        "session_id": {
          "type": "string"
        }
      },
      "required": [
        "tool_name",
        "session_id"
      ],
      "type": "object"
    },
    "stopped_session_id": {
      "description": "stop_session 已请求停止的会话 ID。",
      "type": "string"
    },
    "deleted_session_id": {
      "description": "使用单个 session_id 执行删除时返回的目标 ID；完整范围见 deleted_session_ids。",
      "type": "string"
    },
    "error": {
      "description": "动作失败时的稳定错误说明。",
      "type": "string"
    },
    "anchor_session_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "list_sessions 实际关系中心；all/roots 时为 null。"
    },
    "group_filter": {
      "type": [
        "string",
        "null"
      ],
      "description": "list_sessions 的分类筛选，null 表示不过滤。"
    },
    "status_filter": {
      "type": [
        "string",
        "null"
      ],
      "description": "list_sessions 的运行状态筛选，null 表示不过滤。"
    },
    "target_session_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "用户/AI明确选择的目标，去重后保留；尚未展开后代。"
    },
    "session_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "preview_delete 完整待删清单。要固定此次预览范围，执行时原样传入 session_ids 并使用 include_descendants=false。"
    },
    "deleted_session_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "delete_session 执行成功时已删除的完整 ID 清单。"
    },
    "include_descendants": {
      "type": "boolean",
      "description": "本次是否将目标的全部后代展开加入清单。"
    },
    "reparented_sessions": {
      "type": "array",
      "description": "预览中保留下级的预计新父级；parent_session_id=null 表示成为顶层。这是预览时的快照。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "session_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "previous_parent_session_id": {
            "type": "string"
          },
          "parent_session_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "session_id",
          "title",
          "previous_parent_session_id",
          "parent_session_id"
        ]
      }
    }
  },
  "required": [
    "ok",
    "action"
  ],
  "type": "object"
}
