{
  "description": "向当前项目的已有 AI 会话委派任务、交流或接收汇报；创建和配置会话使用 manage_ai_conversations。",
  "registration_name": "AI 会话交互",
  "execution": {
    "parallel": true
  },
  "files": {
    "examples": ".tool/examples.json",
    "permissions": ".tool/permissions.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json"
  },
  "io": {
    "input": "client_json",
    "output": "client_json"
  },
  "loading": {
    "dynamic": false
  },
  "name": "interact_ai_conversation",
  "runtime": {
    "client_capability": {
      "name": "conversation.interaction",
      "min_version": 1
    },
    "timeout_seconds": 3600,
    "type": "client"
  },
  "state": {
    "enabled": true
  }
}
