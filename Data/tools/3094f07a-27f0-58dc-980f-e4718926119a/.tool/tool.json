{
  "description": "向当前项目中已经存在的 AI 会话发送普通用户消息。工具会校验目标会话的实时状态；同一会话正在运行时会明确拒绝新的生成请求，不会静默排队。发送时既可等待本次精确回复，也可在消息被持久化后立即返回并让目标会话独立运行。工具会在消息正文末尾追加实时来源会话名称和 ID，目标 AI 可据此准确回传，用户也能直接看到协作来源。需要目标 AI 读取文件或图片时，应在消息中写入可访问路径并明确要求读取。列出、创建、查看或配置会话请使用 manage_ai_conversations。",
  "registration_name": "AI 会话交互",
  "execution": {
    "parallel": true
  },
  "files": {
    "examples": ".tool/examples.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json"
  },
  "io": {
    "input": "client_json",
    "output": "client_json"
  },
  "keywords": [
    "AI会话",
    "会话交互",
    "发送消息",
    "文件路径",
    "图片路径",
    "等待回复",
    "后台运行",
    "前端能力"
  ],
  "loading": {
    "dynamic": false
  },
  "name": "interact_ai_conversation",
  "runtime": {
    "client_capability": {
      "name": "conversation.interaction",
      "min_version": 1
    },
    "timeout_seconds": 3600,
    "type": "client"
  },
  "state": {
    "enabled": true
  }
}
