{
  "description": "用 unified diff 完成多处或多文件修改；单文件的小范围字符串替换使用 replace_text。",
  "registration_name": "文件补丁编辑",
  "execution": {
    "parallel": true
  },
  "files": {
    "examples": ".tool/examples.json",
    "permissions": ".tool/permissions.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "loading": {
    "dynamic": false
  },
  "name": "safe_patch",
  "runtime": {
    "entry": "program/main.py",
    "timeout_seconds": 90,
    "type": "python"
  },
  "state": {
    "enabled": true
  }
}
