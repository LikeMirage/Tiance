{
  "description": "查看、搜索和维护全局及项目长期记忆，支持普通会话管理和后台记忆维护任务。",
  "registration_name": "记忆管理",
  "execution": {
    "parallel": true
  },
  "files": {
    "examples": ".tool/examples.json",
    "permissions": ".tool/permissions.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "loading": {
    "dynamic": false
  },
  "name": "manage_memory",
  "runtime": {
    "entry": "program/main.py",
    "timeout_seconds": 30,
    "type": "python",
    "host_capabilities": [
      "memory_management"
    ]
  },
  "state": {
    "enabled": true
  }
}
