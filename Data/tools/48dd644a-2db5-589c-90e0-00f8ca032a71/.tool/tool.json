{
  "description": "查看和管理 天策 长期记忆。list/search 一次返回全部当前有效的全局记忆和项目记忆；新增、更新和删除需指定写入范围。所有修改都通过后端记忆事件链路写入，不直接编辑记忆文件。",
  "display_name": "记忆管理",
  "execution": {
    "parallel": true
  },
  "files": {
    "examples": ".tool/examples.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "keywords": [
    "记忆",
    "长期记忆",
    "全局记忆",
    "项目记忆",
    "上下文",
    "管理"
  ],
  "loading": {
    "dynamic": false
  },
  "name": "manage_memory",
  "runtime": {
    "entry": "program/main.py",
    "timeout_seconds": 30,
    "type": "python"
  },
  "state": {
    "enabled": true
  }
}
