{
  "description": "在天策编辑器中打开、聚焦和整理项目文件标签，方便向用户展示产物。",
  "registration_name": "编辑器标签页管理",
  "execution": {
    "parallel": true
  },
  "files": {
    "examples": ".tool/examples.json",
    "permissions": ".tool/permissions.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json"
  },
  "io": {
    "input": "client_json",
    "output": "client_json"
  },
  "loading": {
    "dynamic": false
  },
  "name": "editor_tabs_manager",
  "runtime": {
    "client_capability": {
      "name": "editor.tabs",
      "min_version": 1
    },
    "timeout_seconds": 30,
    "type": "client"
  },
  "state": {
    "enabled": true
  }
}
