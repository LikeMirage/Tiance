{
  "description": "管理编辑器标签并展示项目文件。open_file 可打开 Office 等文件；reveal_file 仅定位 PDF 页码或纯文本源码选区，不支持 Word、Excel、PPT 内容定位。",
  "registration_name": "编辑器标签页管理",
  "execution": {
    "parallel": true
  },
  "files": {
    "examples": ".tool/examples.json",
    "permissions": ".tool/permissions.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json"
  },
  "io": {
    "input": "client_json",
    "output": "client_json"
  },
  "loading": {
    "dynamic": false
  },
  "name": "editor_tabs_manager",
  "runtime": {
    "client_capability": {
      "name": "editor.tabs",
      "min_version": 3
    },
    "timeout_seconds": 30,
    "type": "client"
  },
  "state": {
    "enabled": true
  }
}
