{
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "enum": [
              "zoom",
              "refresh",
              "wait",
              "close",
              "activate"
            ]
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "gui_session_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "zoom"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "frame_id",
          "view_id"
        ],
        "oneOf": [
          {
            "required": [
              "cell_id"
            ],
            "not": {
              "required": [
                "cell_ids"
              ]
            }
          },
          {
            "required": [
              "cell_ids"
            ],
            "not": {
              "required": [
                "cell_id"
              ]
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "grid_mode": {
            "const": "fixed"
          }
        },
        "required": [
          "grid_mode"
        ]
      },
      "then": {
        "required": [
          "grid_rows",
          "grid_cols"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "activate"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "gui_session_id"
        ],
        "properties": {
          "action": {},
          "gui_session_id": {},
          "activation_timeout_ms": {}
        },
        "additionalProperties": false
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "view"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "gui_session_id",
          "frame_id",
          "view_id"
        ],
        "properties": {
          "action": {},
          "gui_session_id": {},
          "frame_id": {},
          "view_id": {},
          "overlay": {}
        },
        "additionalProperties": false
      }
    },
    {
      "if": {
        "required": [
          "overlay"
        ]
      },
      "then": {
        "properties": {
          "action": {
            "enum": [
              "start",
              "zoom",
              "view",
              "refresh",
              "wait"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "activation_timeout_ms"
        ]
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "action": {
                "const": "activate"
              }
            }
          },
          {
            "required": [
              "target",
              "activate"
            ],
            "properties": {
              "action": {
                "const": "start"
              },
              "target": {
                "const": "window"
              },
              "activate": {
                "const": true
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "required": [
          "activate"
        ]
      },
      "then": {
        "required": [
          "target"
        ],
        "properties": {
          "action": {
            "const": "start"
          },
          "target": {
            "const": "window"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "offset"
        ]
      },
      "then": {
        "properties": {
          "action": {
            "const": "list_windows"
          }
        }
      }
    }
  ],
  "description": "先等待 gui_runtime start 锁定成功；list_windows 列出窗口，start 建立截图会话，后续动作使用实际返回的会话与最新 Frame/View。用户中断或解锁后须重新建立会话。完整流程及异常处理见“操作流程与注意事项”。",
  "properties": {
    "activation_timeout_ms": {
      "type": "integer",
      "minimum": 100,
      "maximum": 10000,
      "default": 2000,
      "description": "仅显式激活时使用：窗口start须同时activate=true，或action=activate。默认2000毫秒，范围100至10000，每50毫秒确认，取消即退出；超时明确失败。",
      "permission_type": "none"
    },
    "action": {
      "type": "string",
      "enum": [
        "list_windows",
        "start",
        "zoom",
        "refresh",
        "wait",
        "close",
        "activate",
        "view"
      ],
      "description": "先锁定。start创建截图；zoom创建子View；view返回已有视图/切换叠加层，使用最新frame_id和真实view_id；refresh/wait生成新截图。 close关闭会话并保留数据，最后一个会话关闭时释放界面锁。",
      "permission_type": "ui_control"
    },
    "contains": {
      "type": "string",
      "description": "按窗口标题包含文字筛选。",
      "permission_type": "none"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300,
      "default": 100,
      "description": "list_windows单页窗口数量；返回total、complete、next_offset，不静默丢弃后续窗口。",
      "permission_type": "none"
    },
    "target": {
      "type": "string",
      "enum": [
        "screen",
        "window"
      ],
      "default": "screen",
      "description": "start查看全部/单个屏幕或窗口。",
      "permission_type": "none"
    },
    "monitor": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "screen目标的显示器编号；0为完整虚拟桌面，1开始为各显示器。",
      "permission_type": "none"
    },
    "hwnd": {
      "type": "integer",
      "minimum": 1,
      "description": "window目标的窗口句柄，优先于标题。",
      "permission_type": "none"
    },
    "window_title": {
      "type": "string",
      "minLength": 1,
      "description": "window目标标题，先精确匹配再包含匹配；不填时使用前台窗口。",
      "permission_type": "none"
    },
    "gui_session_id": {
      "type": "string",
      "pattern": "^gui_[a-f0-9]{32}$",
      "description": "gui_inspect start 实际返回的 GUI 会话 ID，不使用示例占位值。",
      "permission_type": "none"
    },
    "frame_id": {
      "type": "integer",
      "minimum": 0,
      "description": "使用实际观察过的最新Frame编号，并与view_id所属Frame一致。操作或刷新返回新Frame后，旧Frame的放大View不能沿用。",
      "permission_type": "none"
    },
    "view_id": {
      "type": "string",
      "minLength": 1,
      "description": "当前frame_id中已实际返回的View ID。新Frame最初只有root；旧Frame的放大View不会继承，须先从新Frame的root重新zoom。",
      "permission_type": "none"
    },
    "cell_id": {
      "type": "integer",
      "minimum": 1,
      "description": "在输入frame_id/view_id已有网格中选择的格号，不是放大后新网格的格号。",
      "permission_type": "none"
    },
    "grid_mode": {
      "type": "string",
      "enum": [
        "auto",
        "fixed"
      ],
      "description": "start初始默认auto；refresh省略时保持根视图原设置。zoom仅设置放大后新View的网格，选区仍按输入view_id的已有格号；不改变来源网格或frame_id。",
      "permission_type": "none"
    },
    "zoom_scale_percent": {
      "type": "integer",
      "minimum": 100,
      "maximum": 800,
      "default": 400,
      "description": "仅zoom使用：相对父View中选区显示尺寸的请求百分比，默认400%。按父View实际显示比例计算，再等比例约束，使子View宽和高均不超过直接父View的图片尺寸；返回effective_zoom_scale_percent及zoom_limited_by_parent，取整后的实际倍率见sampling。100%保持选区在父View中的显示比例。小选区仍可放大；整行、整列或全选可能受限，需缩小选区。先缩放干净底图，再重画1像素网格及编号，屏幕坐标不变。",
      "permission_type": "none"
    },
    "grid_target_cells": {
      "type": "integer",
      "minimum": 4,
      "maximum": 64,
      "description": "auto模式期望的格子数量。zoom时仅用于放大后新View，不改变来源View的格号。",
      "permission_type": "none"
    },
    "grid_rows": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16,
      "description": "fixed模式行数。zoom时仅设置放大后新View的行数，不参与解释cell_id/cell_ids。",
      "permission_type": "none"
    },
    "grid_cols": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16,
      "description": "fixed模式列数。zoom时仅设置放大后新View的列数，不参与解释cell_id/cell_ids。",
      "permission_type": "none"
    },
    "mode": {
      "type": "string",
      "enum": [
        "change",
        "stable"
      ],
      "default": "stable",
      "description": "wait等待发生变化或连续稳定；stable仅表示画面连续稳定，不证明应用业务成功。",
      "permission_type": "none"
    },
    "change_threshold_percent": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 100,
      "default": 0.5,
      "description": "判定界面变化的像素占比百分数；任一RGB通道变化达到16的像素计为变化。",
      "permission_type": "none"
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 100,
      "maximum": 30000,
      "default": 5000,
      "description": "wait最长等待毫秒数。",
      "permission_type": "none"
    },
    "interval_ms": {
      "type": "integer",
      "minimum": 50,
      "maximum": 2000,
      "default": 250,
      "description": "wait采样间隔毫秒数。",
      "permission_type": "none"
    },
    "stable_checks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "default": 2,
      "description": "stable需要连续满足的采样次数。",
      "permission_type": "none"
    },
    "cell_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "description": "按输入frame_id/view_id已有网格选择多个格子，必须连续、无缺口并恰好构成矩形。已有网格每行5格时[1,2,6,7]有效、[1,2,6]拒绝；已有2×2网格仅可选1至4，即使本次输出设为3×3也不能选5至9。",
      "permission_type": "none"
    },
    "overlay": {
      "type": "string",
      "enum": [
        "labels+lines",
        "lines",
        "none"
      ],
      "description": "仅用于start/zoom/view/refresh/wait。start默认labels+lines；zoom省略时继承父View；view省略保持原样。refresh/wait省略继承根设置。labels+lines显示编号和线，lines仅线，none无叠加；均保留格号映射。不会自动隐藏编号；只有显式选择lines或none才关闭编号。",
      "permission_type": "none"
    },
    "activate": {
      "type": "boolean",
      "default": false,
      "description": "仅start target=window使用。默认false只观察、不抢焦点，避免关闭弹出菜单；true先激活再截图。",
      "permission_type": "ui_control"
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "list_windows分页起点，沿next_offset继续读取。窗口列表为每次实时枚举。",
      "permission_type": "none"
    }
  },
  "required": [
    "action"
  ],
  "type": "object"
}
