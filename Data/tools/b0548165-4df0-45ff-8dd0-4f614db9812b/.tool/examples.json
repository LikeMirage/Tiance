[
  {
    "title": "列出窗口",
    "content": "{\n  \"action\": \"list_windows\",\n  \"limit\": 100\n}"
  },
  {
    "title": "查看完整桌面",
    "content": "{\n  \"action\": \"start\",\n  \"target\": \"screen\",\n  \"monitor\": 0,\n  \"grid_mode\": \"auto\",\n  \"grid_target_cells\": 16\n}"
  },
  {
    "title": "放大网格",
    "content": "{\n  \"action\": \"zoom\",\n  \"gui_session_id\": \"gui_0123456789abcdef0123456789abcdef\",\n  \"frame_id\": 0,\n  \"view_id\": \"root\",\n  \"cell_id\": 6\n}"
  },
  {
    "title": "等待画面稳定（仍须确认业务结果）",
    "content": "{\n  \"action\": \"wait\",\n  \"gui_session_id\": \"gui_0123456789abcdef0123456789abcdef\",\n  \"mode\": \"stable\",\n  \"change_threshold_percent\": 0.5,\n  \"timeout_ms\": 5000,\n  \"interval_ms\": 250,\n  \"stable_checks\": 2\n}"
  },
  {
    "title": "放大两行五列视图中的矩形四格",
    "content": "{\n  \"action\": \"zoom\",\n  \"gui_session_id\": \"gui_0123456789abcdef0123456789abcdef\",\n  \"frame_id\": 0,\n  \"view_id\": \"root\",\n  \"cell_ids\": [\n    1,\n    2,\n    6,\n    7\n  ],\n  \"grid_mode\": \"fixed\",\n  \"grid_rows\": 4,\n  \"grid_cols\": 6\n}"
  },
  {
    "title": "目标失去前台时激活，后续使用返回的新Frame",
    "content": "{\n  \"action\": \"activate\",\n  \"gui_session_id\": \"gui_0123456789abcdef0123456789abcdef\"\n}"
  },
  {
    "title": "直接观察目标窗口或空标题弹窗，不激活（先list_windows取得真实句柄）",
    "content": "{\n  \"action\": \"start\",\n  \"target\": \"window\",\n  \"hwnd\": 123456,\n  \"overlay\": \"labels+lines\"\n}"
  },
  {
    "title": "需要时显式激活普通窗口后截图（会使某些菜单收起）",
    "content": "{\n  \"action\": \"start\",\n  \"target\": \"window\",\n  \"hwnd\": 123456,\n  \"activate\": true\n}"
  },
  {
    "title": "返回根视图并仅保留网格线（使用当前Frame）",
    "content": "{\n  \"action\": \"view\",\n  \"gui_session_id\": \"gui_0123456789abcdef0123456789abcdef\",\n  \"frame_id\": 0,\n  \"view_id\": \"root\",\n  \"overlay\": \"lines\"\n}"
  },
  {
    "title": "无叠加观察已有子视图（使用实际返回的view_id）",
    "content": "{\n  \"action\": \"view\",\n  \"gui_session_id\": \"gui_0123456789abcdef0123456789abcdef\",\n  \"frame_id\": 0,\n  \"view_id\": \"6\",\n  \"overlay\": \"none\"\n}"
  }
]
