{
  "description": "查看窗口、截图和逐级放大网格，为界面操作提供坐标依据。首次使用前读取“操作流程与注意事项”。",
  "execution": {
    "parallel": false
  },
  "files": {
    "examples": ".tool/examples.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json",
    "permissions": ".tool/permissions.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "loading": {
    "dynamic": true
  },
  "name": "gui_inspect",
  "registration_name": "GUI 界面查看",
  "runtime": {
    "entry": "program/main.py",
    "timeout_seconds": 45,
    "type": "python"
  },
  "state": {
    "enabled": true
  }
}
