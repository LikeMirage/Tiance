{
  "description": "通过剪映云端识别音视频，生成带时间戳的转录和字幕文件；无需 API Key，适合会议录音与长音频。",
  "execution": {
    "parallel": false
  },
  "files": {
    "examples": ".tool/examples.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json",
    "permissions": ".tool/permissions.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "loading": {
    "dynamic": true
  },
  "name": "jianying_transcribe",
  "registration_name": "剪映音视频转写",
  "runtime": {
    "entry": "program/main.py",
    "host_capabilities": [],
    "timeout_seconds": 3600,
    "type": "python"
  },
  "state": {
    "enabled": false
  }
}
