{
  "description": "识别会议录音、视频及微信 SILK 语音（含 .speex），自动解码并生成带时间戳的转录或字幕；无需 API Key，音轨上传云端。",
  "execution": {
    "parallel": false
  },
  "files": {
    "examples": ".tool/examples.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json",
    "permissions": ".tool/permissions.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "loading": {
    "dynamic": true
  },
  "name": "audio_transcribe",
  "registration_name": "音视频转写",
  "runtime": {
    "entry": "program/main.py",
    "host_capabilities": [],
    "timeout_seconds": 3600,
    "type": "python"
  },
  "state": {
    "enabled": false
  }
}
