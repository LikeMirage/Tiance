{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "input_path": {
      "type": "string",
      "minLength": 1,
      "description": "本地音频或视频路径，相对路径基于当前工作区。支持按文件头自动识别 SILK v3（包括微信 .speex、.silk），直接传原文件，无需预转码；其他音视频走常规解码。音轨上传至字节云端，长音频均分并发后合并，规则与失败处理见使用说明。",
      "permission_type": "network_access",
      "permission_scope": "public_network"
    },
    "output_dir": {
      "type": "string",
      "minLength": 1,
      "description": "结果保存目录，省略为当前工作区。每次创建以源文件名开头的独立结果子目录，避免覆盖已有结果；最终路径由返回值给出。",
      "permission_type": "filesystem_write"
    },
    "formats": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "json",
          "txt",
          "srt",
          "ass"
        ]
      },
      "default": [
        "json"
      ],
      "description": "输出格式，可多选，省略为 [\"json\"]。JSON 保存句段及接口返回的词级时间戳；其他格式用于阅读或字幕导入。",
      "permission_type": "none"
    }
  },
  "required": [
    "input_path"
  ]
}
