{
  "description": "只读检索特定结构的 SQLite 文献库，支持原文、关键词和语义检索。使用前读取“数据库要求与结果判读”。",
  "execution": {
    "parallel": true
  },
  "files": {
    "examples": ".tool/examples.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json",
    "permissions": ".tool/permissions.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "loading": {
    "dynamic": false
  },
  "name": "structured_database_search",
  "registration_name": "结构化数据库检索",
  "runtime": {
    "entry": "program/main.py",
    "timeout_seconds": 300,
    "type": "python"
  },
  "state": {
    "enabled": true
  }
}
