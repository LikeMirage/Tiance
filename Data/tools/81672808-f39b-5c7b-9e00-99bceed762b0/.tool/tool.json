{
  "description": "执行完整 Python 脚本，支持等待结果或后台运行；额外依赖通过 pip_package_manager 安装。",
  "registration_name": "Python 脚本执行",
  "execution": {
    "parallel": true
  },
  "files": {
    "examples": ".tool/examples.json",
    "permissions": ".tool/permissions.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "loading": {
    "dynamic": false
  },
  "name": "run_python_script",
  "runtime": {
    "entry": "program/main.py",
    "timeout_seconds": 660,
    "type": "python"
  },
  "state": {
    "enabled": true
  }
}
