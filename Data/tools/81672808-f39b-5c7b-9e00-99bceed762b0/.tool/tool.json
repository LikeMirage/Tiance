{
  "description": "执行完整、多行、复杂引号或需要额外依赖的 Python 脚本时使用；额外依赖由 pip_package_manager 安装到本工具自己的 dependencies 目录。测试、构建和环境检查等普通短命令使用 run_command。支持等待、后台运行、预期退出码和持久日志。",
  "display_name": "Python 脚本执行",
  "execution": {
    "parallel": true
  },
  "files": {
    "examples": ".tool/examples.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "keywords": [
    "Python",
    "脚本",
    "执行",
    "固定解释器",
    "独立依赖",
    "stdout",
    "stderr",
    "后台运行",
    "自动分离",
    "验证"
  ],
  "loading": {
    "dynamic": false
  },
  "name": "run_python_script",
  "runtime": {
    "entry": "program/main.py",
    "timeout_seconds": 660,
    "type": "python"
  },
  "state": {
    "enabled": true
  }
}
