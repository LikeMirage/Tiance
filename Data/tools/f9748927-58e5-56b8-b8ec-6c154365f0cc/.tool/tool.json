{
  "description": "通过 DMXAPI 调用豆包视觉模型解析一张或多张图片，按固定文档视觉识别规则输出 Markdown；默认直接返回结果，也可把每张图片的结果保存为同名 .md 文件。",
  "display_name": "DMX 豆包视觉解析",
  "execution": {
    "parallel": true
  },
  "files": {
    "examples": ".tool/examples.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "keywords": [
    "豆包",
    "视觉解析",
    "图片识别",
    "OCR",
    "Markdown",
    "DMXAPI",
    "多图片"
  ],
  "loading": {
    "dynamic": true
  },
  "name": "doubao_vision_parse",
  "runtime": {
    "entry": "program/main.py",
    "timeout_seconds": 7200,
    "type": "python"
  },
  "state": {
    "enabled": true
  }
}
