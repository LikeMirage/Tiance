{
  "additionalProperties": false,
  "description": "先等待 gui_runtime start 成功；除列窗口外，操作使用 gui_inspect 建立的真实会话与最新观察结果。用户中断或解锁后须重新建立会话。完整流程及异常处理见本工具“操作流程与注意事项”。",
  "properties": {
    "screenshot_delay_seconds": {
      "type": "number",
      "minimum": 0,
      "maximum": 30,
      "default": 1,
      "description": "操作全部结束后等待再截图，默认1秒，可设0到30秒（含小数）；0立即截图，等待期间Esc立即取消。整批只在末尾等待一次。截图等待计入调用总时限。",
      "permission_type": "none"
    },
    "gui_session_id": {
      "type": "string",
      "pattern": "^gui_[a-f0-9]{32}$",
      "permission_type": "none",
      "description": "gui_inspect start 实际返回的 GUI 会话 ID，不使用示例占位值。"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "permission_type": "ui_control",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "enum": [
                    "move",
                    "click",
                    "drag",
                    "scroll",
                    "mouse_down",
                    "mouse_up"
                  ]
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "frame_id",
                "view_id",
                "cell_id",
                "x",
                "y"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "drag"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "to"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "type_text"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "text"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "press_key"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "key"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "hotkey"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "keys"
              ]
            }
          }
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "move",
              "click",
              "drag",
              "scroll",
              "mouse_down",
              "mouse_up",
              "type_text",
              "press_key",
              "hotkey",
              "wait"
            ]
          },
          "frame_id": {
            "type": "integer",
            "minimum": 0
          },
          "view_id": {
            "type": "string",
            "minLength": 1
          },
          "cell_id": {
            "type": "integer",
            "minimum": 1
          },
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "to": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "view_id": {
                "type": "string",
                "minLength": 1
              },
              "cell_id": {
                "type": "integer",
                "minimum": 1
              },
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "view_id",
              "cell_id",
              "x",
              "y"
            ]
          },
          "button": {
            "type": "string",
            "enum": [
              "left",
              "right",
              "middle"
            ],
            "default": "left"
          },
          "clicks": {
            "type": "integer",
            "enum": [
              1,
              2
            ],
            "default": 1
          },
          "click_hold_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2000,
            "default": 80,
            "description": "每次click按下到抬起的时长，默认80毫秒。"
          },
          "modifiers": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "ctrl",
                "shift",
                "alt",
                "win"
              ]
            },
            "uniqueItems": true,
            "maxItems": 4,
            "default": []
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000,
            "default": 0
          },
          "direction": {
            "type": "string",
            "enum": [
              "up",
              "down",
              "left",
              "right"
            ],
            "default": "down"
          },
          "notches": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 3
          },
          "interval_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2000,
            "default": 20
          },
          "text": {
            "type": "string",
            "maxLength": 100000
          },
          "key": {
            "type": "string",
            "minLength": 1
          },
          "keys": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 2,
            "maxItems": 8
          },
          "presses": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 1
          },
          "hold_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2000,
            "default": 0
          }
        },
        "required": [
          "type"
        ]
      },
      "description": "顺序执行的动作列表，字段含义见各动作；任一步失败停止后续步骤，不重放已完成动作。"
    },
    "frame_id": {
      "type": "integer",
      "minimum": 0,
      "permission_type": "none",
      "description": "本批操作实际观察过的最新 Frame ID，作为未逐项指定时的依据。"
    }
  },
  "required": [
    "gui_session_id",
    "actions",
    "frame_id"
  ],
  "type": "object"
}
