{
  "additionalProperties": false,
  "description": "【最短持锁】只在当前GUI操作及必要界面确认期间持锁。当前GUI阶段结束，或下一步不再需要GUI时，立即gui_runtime stop并核实释放；等待用户、失败或取消时也先解锁，不等整件任务结束或空闲超时。如需切换展示窗口，最多尝试一次，随后立即stop，不以切换成功作为解锁前提。解锁后继续GUI操作须重新gui_runtime start并用gui_inspect start建立新会话，不沿用旧Frame、预览或控件引用。 先调用gui_runtime start并等待成功锁定，再用gui_inspect start取得截图会话和坐标依据。一次提交1至50个顺序动作，适合目标明确、顺序确定的连续操作，鼠标键盘不能并发。整批使用已观察的frame_id；各步不比较截图像素，前一步输入、菜单或滚动造成的画面变化不拦截后一步。保留窗口身份、尺寸及键盘目标窗口检查，drag另核对起点窗口位置和遮挡。新对话框需重新观察，不自动把后续输入转过去。任一步失败停止后续动作，返回completed_actions、failed_action_index（从0开始）和action_results，勿重放已完成步骤。整批末尾只等待和截图一次。操作后返回新截图和当前前台窗口；execution_status只表示输入是否完成，observation_status单独表示截图是否取得。输入已完成但截图失败时，不要重放动作，先重新观察。 GUI操作中收到用户新消息，表示用户已解除锁定并暂停上一轮AI对话；如需继续操作，必须重新调用gui_runtime start并等待成功，再调用gui_inspect start建立新会话并重新观察，不沿用旧会话、Frame、预览或控件引用。 提交前确认目标前台与键盘输入位置；必要时先激活并使用新Frame。表单控件支持UIA能力时可改用独立gui_uia调用，本工具的批量动作仍只包含既有鼠标、键盘和等待动作。",
  "properties": {
    "screenshot_delay_seconds": {
      "type": "number",
      "minimum": 0,
      "maximum": 30,
      "default": 1,
      "description": "操作全部结束后等待再截图，默认1秒，可设0到30秒（含小数）；0立即截图，等待期间Esc立即取消。整批只在末尾等待一次。截图等待计入调用总时限。",
      "permission_type": "none"
    },
    "gui_session_id": {
      "type": "string",
      "pattern": "^gui_[a-f0-9]{32}$",
      "permission_type": "none"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "permission_type": "ui_control",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "enum": [
                    "move",
                    "click",
                    "drag",
                    "scroll",
                    "mouse_down",
                    "mouse_up"
                  ]
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "frame_id",
                "view_id",
                "cell_id",
                "x",
                "y"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "drag"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "to"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "type_text"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "text"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "press_key"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "key"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "hotkey"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "keys"
              ]
            }
          }
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "move",
              "click",
              "drag",
              "scroll",
              "mouse_down",
              "mouse_up",
              "type_text",
              "press_key",
              "hotkey",
              "wait"
            ]
          },
          "frame_id": {
            "type": "integer",
            "minimum": 0
          },
          "view_id": {
            "type": "string",
            "minLength": 1
          },
          "cell_id": {
            "type": "integer",
            "minimum": 1
          },
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "to": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "view_id": {
                "type": "string",
                "minLength": 1
              },
              "cell_id": {
                "type": "integer",
                "minimum": 1
              },
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "view_id",
              "cell_id",
              "x",
              "y"
            ]
          },
          "button": {
            "type": "string",
            "enum": [
              "left",
              "right",
              "middle"
            ],
            "default": "left"
          },
          "clicks": {
            "type": "integer",
            "enum": [
              1,
              2
            ],
            "default": 1
          },
          "click_hold_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2000,
            "default": 80,
            "description": "每次click按下到抬起的时长，默认80毫秒。"
          },
          "modifiers": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "ctrl",
                "shift",
                "alt",
                "win"
              ]
            },
            "uniqueItems": true,
            "maxItems": 4,
            "default": []
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000,
            "default": 0
          },
          "direction": {
            "type": "string",
            "enum": [
              "up",
              "down",
              "left",
              "right"
            ],
            "default": "down"
          },
          "notches": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 3
          },
          "interval_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2000,
            "default": 20
          },
          "text": {
            "type": "string",
            "maxLength": 100000
          },
          "key": {
            "type": "string",
            "minLength": 1
          },
          "keys": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 2,
            "maxItems": 8
          },
          "presses": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 1
          },
          "hold_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2000,
            "default": 0
          }
        },
        "required": [
          "type"
        ]
      }
    },
    "frame_id": {
      "type": "integer",
      "minimum": 0,
      "permission_type": "none"
    }
  },
  "required": [
    "gui_session_id",
    "actions",
    "frame_id"
  ],
  "type": "object"
}
