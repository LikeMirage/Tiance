{
  "description": "按明确顺序批量执行已观察界面的鼠标、键盘和等待动作。首次使用前读取“操作流程与注意事项”。",
  "execution": {
    "parallel": false
  },
  "files": {
    "examples": ".tool/examples.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json",
    "permissions": ".tool/permissions.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "loading": {
    "dynamic": true
  },
  "name": "gui_batch",
  "registration_name": "GUI 批量操作",
  "runtime": {
    "entry": "program/main.py",
    "timeout_seconds": 160,
    "type": "python"
  },
  "state": {
    "enabled": true
  }
}
