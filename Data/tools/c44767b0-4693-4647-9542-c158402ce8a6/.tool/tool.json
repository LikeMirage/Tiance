{
  "description": "将天策各类项目集与 GitHub 仓库绑定、同步，适合集合备份和跨设备迁移。普通 Git 操作使用 git_repository。",
  "registration_name": "GitHub 仓库同步",
  "execution": {
    "parallel": true
  },
  "files": {
    "examples": ".tool/examples.json",
    "permissions": ".tool/permissions.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "loading": {
    "dynamic": true
  },
  "name": "github_repository_sync",
  "runtime": {
    "entry": "program/main.py",
    "timeout_seconds": 600,
    "type": "python",
    "host_capabilities": [
      "github_sync"
    ]
  },
  "state": {
    "enabled": true
  }
}
