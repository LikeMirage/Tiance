{
  "description": "查看和管理项目集、知识集、经验集、角色集、主题集、工具集或供应商集与 GitHub 仓库的同步。支持读取已授权仓库、绑定仓库、预览拉取或提交差异，并凭计划号执行；未明确确认差异前不要执行 pull 或 push。优先复用天策 GitHub 登录，未登录时可使用工具 config.json 中的 Token。",
  "display_name": "GitHub 仓库同步",
  "execution": {
    "parallel": true
  },
  "files": {
    "examples": ".tool/examples.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "keywords": [
    "GitHub",
    "Git",
    "私人仓库",
    "同步",
    "提交",
    "拉取",
    "备份",
    "多地同步"
  ],
  "loading": {
    "dynamic": false
  },
  "name": "github_repository_sync",
  "runtime": {
    "entry": "program/main.py",
    "timeout_seconds": 600,
    "type": "python"
  },
  "state": {
    "enabled": true
  }
}

