{
  "additionalProperties": false,
  "description": "创建、检查或安全编辑 .pptx。action=create 时传 output_path 和 slides；也可传 template_path 与 template_slide_indexes 复用模板页。action=edit 时传 input_path、output_path 和 operations；action=inspect 时传 input_path。坐标单位为英寸，x/y/w/h 均相对于幻灯片左上角。编辑默认不覆盖原文件，保存后会做基础完整性检查。",
  "properties": {
    "action": {
      "description": "操作类型。",
      "enum": [
        "create",
        "inspect",
        "edit"
      ],
      "options": [
        {
          "value": "create",
          "description": "从结构化 JSON 新建 PPTX。"
        },
        {
          "value": "inspect",
          "description": "读取 PPTX 概况和每页文本摘要。"
        },
        {
          "value": "edit",
          "description": "对已有 PPTX 做安全编辑并输出到新文件或覆盖文件。"
        }
      ],
      "title": "操作",
      "type": "string"
    },
    "input_path": {
      "description": "已有 PPTX 路径。inspect/edit 必填。相对路径按工作区根目录解析。",
      "title": "输入 PPTX",
      "type": "string"
    },
    "output_path": {
      "description": "输出 PPTX 路径。create/edit 必填。相对路径按工作区根目录解析。",
      "title": "输出 PPTX",
      "type": "string"
    },
    "template_path": {
      "description": "create 可选：已有 PPTX 模板路径。会保留模板页和资源，可配合 template_slide_indexes 选择、复制、重排模板页。",
      "title": "模板 PPTX",
      "type": "string"
    },
    "template_slide_indexes": {
      "description": "create 可选：从模板中选取并按顺序复制的 0 基页码数组。支持重复页码；不传则保留模板全部页面。",
      "items": {
        "type": "integer"
      },
      "title": "模板页序列",
      "type": "array"
    },
    "overwrite": {
      "default": false,
      "description": "输出文件已存在时是否覆盖。默认 false。",
      "title": "覆盖输出文件",
      "type": "boolean"
    },
    "backup": {
      "default": true,
      "description": "edit 且覆盖原文件时是否先创建 .bak 备份。",
      "title": "覆盖原文件前备份",
      "type": "boolean"
    },
    "dry_run": {
      "default": false,
      "description": "只检查将要执行的编辑操作，不写文件。create 时忽略。",
      "title": "预演编辑",
      "type": "boolean"
    },
    "page": {
      "additionalProperties": false,
      "description": "页面尺寸设置。默认 16:9 宽屏。",
      "properties": {
        "size": {
          "default": "wide",
          "description": "wide=13.333x7.5，standard=10x7.5，custom=使用 width/height。",
          "enum": [
            "wide",
            "standard",
            "custom"
          ],
          "type": "string"
        },
        "width": {
          "description": "custom 宽度，单位英寸。",
          "type": "number"
        },
        "height": {
          "description": "custom 高度，单位英寸。",
          "type": "number"
        }
      },
      "title": "页面尺寸",
      "type": "object"
    },
    "theme": {
      "additionalProperties": true,
      "description": "主题设置。支持 primary_color、accent_color、background_color、text_color、muted_color、font_family。",
      "title": "主题",
      "type": "object"
    },
    "properties": {
      "additionalProperties": true,
      "description": "文档属性，例如 title、subject、author、company、category、keywords、comments。",
      "title": "文档属性",
      "type": "object"
    },
    "slides": {
      "description": "create 的幻灯片数组，或 edit/add_slide 操作中的 slide 对象。每页可用 layout 快速生成，也可传 elements 精确排版。",
      "items": {
        "additionalProperties": true,
        "properties": {
          "layout": {
            "default": "title_content",
            "description": "内置版式：title、section、title_content、two_column、image_focus、table、blank。",
            "enum": [
              "title",
              "section",
              "title_content",
              "two_column",
              "image_focus",
              "table",
              "blank"
            ],
            "type": "string"
          },
          "title": {
            "description": "标题文本。",
            "type": "string"
          },
          "subtitle": {
            "description": "副标题文本。",
            "type": "string"
          },
          "body": {
            "description": "正文文本。",
            "type": "string"
          },
          "bullets": {
            "description": "要点列表。元素可以是字符串，也可以是 {text, level}。",
            "items": {},
            "type": "array"
          },
          "background": {
            "additionalProperties": true,
            "description": "背景设置，例如 {\"color\":\"F8FAFC\"}。",
            "type": "object"
          },
          "image_path": {
            "description": "image_focus 版式的主图路径。",
            "type": "string"
          },
          "image_sizing": {
            "default": "contain",
            "description": "image_focus 主图放入图片框的方式：contain=等比例完整显示，cover=等比例裁切填满，stretch=拉伸填满。",
            "enum": [
              "contain",
              "cover",
              "stretch"
            ],
            "type": "string"
          },
          "table": {
            "additionalProperties": true,
            "description": "table 版式的表格定义，包含 rows、x、y、w、h。",
            "type": "object"
          },
          "elements": {
            "description": "精确元素数组。支持 text、bullets、image、table、shape、line。",
            "items": {
              "additionalProperties": true,
              "properties": {
                "type": {
                  "enum": [
                    "text",
                    "bullets",
                    "image",
                    "table",
                    "shape",
                    "line"
                  ],
                  "type": "string"
                },
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "w": {
                  "type": "number"
                },
                "h": {
                  "type": "number"
                },
                "text": {
                  "type": "string"
                },
                "items": {
                  "items": {},
                  "type": "array"
                },
                "image_path": {
                  "type": "string"
                },
                "sizing": {
                  "default": "contain",
                  "description": "image 元素图片放入图片框的方式：contain=等比例完整显示，cover=等比例裁切填满，stretch=拉伸填满。",
                  "enum": [
                    "contain",
                    "cover",
                    "stretch"
                  ],
                  "type": "string"
                },
                "rows": {
                  "items": {
                    "items": {},
                    "type": "array"
                  },
                  "type": "array"
                },
                "style": {
                  "additionalProperties": true,
                  "type": "object"
                }
              },
              "required": [
                "type"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "title": "幻灯片",
      "type": "array"
    },
    "operations": {
      "description": "edit 操作数组。支持 replace_text、set_slide_title、add_slide、delete_slide、duplicate_slide、move_slide、reorder_slides。",
      "items": {
        "additionalProperties": true,
        "properties": {
          "type": {
            "enum": [
              "replace_text",
              "set_slide_title",
              "add_slide",
              "delete_slide",
              "duplicate_slide",
              "move_slide",
              "reorder_slides"
            ],
            "type": "string"
          },
          "slide_indexes": {
            "description": "0 基页码数组。不传表示全部页。",
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "slide_index": {
            "description": "0 基页码。",
            "type": "integer"
          },
          "old_text": {
            "type": "string"
          },
          "new_text": {
            "type": "string"
          },
          "match_case": {
            "default": true,
            "type": "boolean"
          },
          "title": {
            "type": "string"
          },
          "slide": {
            "additionalProperties": true,
            "description": "add_slide 的新幻灯片定义。",
            "type": "object"
          },
          "index": {
            "description": "add_slide/duplicate_slide/move_slide 的目标位置。省略则追加到末尾。",
            "type": "integer"
          },
          "confirm_delete": {
            "default": false,
            "description": "delete_slide 必须显式 true。",
            "type": "boolean"
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "title": "编辑操作",
      "type": "array"
    },
    "inspect": {
      "additionalProperties": false,
      "description": "inspect 输出控制。",
      "properties": {
        "include_text_runs": {
          "default": false,
          "description": "是否返回更细的文本段信息。",
          "type": "boolean"
        },
        "include_package_metadata": {
          "default": true,
          "description": "是否返回包级元数据，例如媒体、图表、备注、嵌入对象和主题信息。",
          "type": "boolean"
        },
        "include_shape_inventory": {
          "default": false,
          "description": "是否返回文字框位置、大小、段落和静态风险信息。用于精确编辑前定位。",
          "type": "boolean"
        },
        "include_static_risks": {
          "default": true,
          "description": "是否返回文字拥挤、跑出页面等静态风险估算。",
          "type": "boolean"
        },
        "max_text_chars_per_slide": {
          "default": 2000,
          "description": "每页最多返回文本字符数。",
          "maximum": 10000,
          "minimum": 200,
          "type": "integer"
        },
        "max_text_chars_per_shape": {
          "default": 1200,
          "description": "include_shape_inventory=true 时每个文字框最多返回文本字符数。",
          "maximum": 10000,
          "minimum": 200,
          "type": "integer"
        }
      },
      "title": "检查选项",
      "type": "object"
    }
  },
  "required": [
    "action"
  ],
  "type": "object"
}
