{
  "description": "检查 天策 工具目录、配置、输入输出契约、示例和入口文件是否符合标准，适合制作或调整工具后的验收。",
  "display_name": "工具体检",
  "execution": {
    "parallel": true
  },
  "files": {
    "examples": ".tool/examples.json",
    "input_schema": ".tool/input.schema.json",
    "output_schema": ".tool/output.schema.json"
  },
  "io": {
    "input": "stdin_json",
    "output": "stdout_json"
  },
  "keywords": [
    "工具体检",
    "工具验收",
    "schema",
    "examples",
    "tool.json",
    "契约检查"
  ],
  "loading": {
    "dynamic": true
  },
  "name": "tool_health_check",
  "runtime": {
    "entry": "program/main.py",
    "timeout_seconds": 60,
    "type": "python"
  },
  "state": {
    "enabled": true
  }
}
