{
  "schemaVersion": 1,
  "families": {
    "deepseek-v4.1": {
      "capabilities": {
        "reasoning": {
          "supported": true,
          "modes": [
            "low",
            "high",
            "max"
          ]
        }
      },
      "request": {
        "reasoningEffortParameter": "reasoning_effort"
      },
      "behavior": {},
      "capabilityTags": [
        "reasoning",
        "vision",
        "function_calling"
      ]
    }
  },
  "models": {
    "deepseek-v4-flash": {
      "capabilities": {
        "outputFormats": [
          "text",
          "json_object"
        ],
        "reasoning": {
          "supported": true,
          "modes": [
            "high",
            "max"
          ]
        },
        "sampling": {
          "supported": true,
          "parameters": [
            "temperature",
            "top_p"
          ],
          "disabledWhenReasoning": true,
          "disabledReason": "DeepSeek 思考模式下 temperature、top_p 不生效。"
        },
        "toolCalling": {
          "supported": true
        }
      },
      "request": {
        "omitParameters": [
          "presence_penalty",
          "frequency_penalty"
        ],
        "jsonObjectResponseFormat": true,
        "streamUsage": true,
        "reasoningEffortParameter": "reasoning_effort"
      },
      "behavior": {},
      "capabilityTags": [
        "reasoning",
        "function_calling"
      ]
    },
    "mimo-v2.5": {
      "capabilities": {
        "reasoning": {
          "supported": true,
          "modes": [
            "off",
            "low",
            "medium",
            "high"
          ]
        }
      },
      "request": {
        "reasoningEffortParameter": "reasoning_effort",
        "reasoningToggleParameter": "thinking",
        "reasoningEnabledValue": {
          "type": "enabled"
        },
        "reasoningDisabledValue": {
          "type": "disabled"
        }
      },
      "behavior": {},
      "capabilityTags": [
        "reasoning"
      ]
    }
  }
}
