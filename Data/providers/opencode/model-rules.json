{
  "schemaVersion": 1,
  "families": {},
  "models": {
    "deepseek-v4-flash": {
      "capabilities": {
        "outputFormats": [
          "text",
          "json_object"
        ],
        "reasoning": {
          "supported": true,
          "modes": [
            "off",
            "high",
            "max"
          ]
        },
        "sampling": {
          "supported": true,
          "parameters": [
            "temperature",
            "top_p"
          ],
          "disabledWhenReasoning": true,
          "disabledReason": "DeepSeek 思考模式下 temperature、top_p 不生效。"
        },
        "toolCalling": {
          "supported": true
        },
        "inputModalities": [
          "text"
        ]
      },
      "request": {
        "omitParameters": [
          "presence_penalty",
          "frequency_penalty"
        ],
        "jsonObjectResponseFormat": true,
        "streamUsage": true,
        "reasoningEffortParameter": "reasoning_effort",
        "reasoningToggleParameter": "thinking",
        "reasoningEnabledValue": {
          "type": "enabled"
        },
        "reasoningDisabledValue": {
          "type": "disabled"
        }
      },
      "behavior": {}
    }
  }
}
